Macro.add('ownQuestionSource',{handler(){const i=Number(this.args[0]),id=i===3?({mix:'B',rules:'D',reader:'A'})[setup.choices[i]]:i===4?'D':'C';new Wikifier(this.output,'<<ownSource '+JSON.stringify(id)+'>>');}});


