ne:3px solid #2391aa;outline-offset:3px}button:disabled{color:#746f62;background:#eeeae2;cursor:not-allowed;opacity:.75}.stone-stats{display:grid;gap:3px;margin:18px 0 8px}.stone-stats>div{display:flex;justify-content:space-between;gap:10px;padding:7px 12px;background:#213b39;border-left:3px solid #b3975f}.stone-stats span{font-size:.75rem;color:#cfccb7}.stone-stats strong{font-size:.8rem;font-weight:600}details{font-size:.88rem;border-bottom:1px solid #b3975f66;padding:12px 0;margin-bottom:12px}summary{cursor:pointer;color:inherit;font-weight:600}details p{margin:12px 0 0}.charge{font-size:.7rem;color:#dfc782;letter-spacing:.1em}.score{padding:16px;background:#315849;color:#fff3c7;font-size:1.3rem;border-radius:3px}a{color:#82cfc0}.dialogue a{color:#22645b}.passage li{margin:8px 0}.stone-note{padding:12px 16px;border-left:3px solid #bcb08d;background:#29423c}.beat-controls{display:flex;align-items:center;gap:8px}.beat-controls button{width:auto}.beat-controls .quiet{margin-left:auto;background:transparent;border-color:transparent;font-size:.75rem}.beat-count{font-size:.7rem;white-space:nowrap}.choice-heading{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;margin-top:20px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:680px){body{font-size:17px}.passage{padding:10px}.novel{display:block}.scene-side{position:static}.stage{height:190px}.character{width:128px}.sprite{height:160px;aspect-ratio:auto}.stone-stats{grid-template-columns:1fr 1fr;margin:12px 0 6px;gap:4px}.stone-stats>div{display:block;padding:5px 8px}.stone-stats span,.stone-stats strong{display:block;font-size:.68rem}.scene-side details{padding:5px 0;font-size:.75rem;margin-bottom:4px}.charge{margin:6px 0 12px}.dialogue{padding:18px;min-height:350px}h1{font-size:1.5rem}.story-beats{min-height:150px}.stone-choice{font-size:.9rem}}@media(prefers-reduced-motion:re