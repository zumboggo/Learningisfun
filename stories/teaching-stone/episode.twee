:: StoryTitle
The Teaching Stone — The Grain We Keep

:: StoryData
{"ifid":"178EAFA2-7B4E-4ED4-AD2B-D39C06947EBB","format":"SugarCube","format-version":"2.37.3","start":"Start"}

:: StoryScript [script]
/** Shared deterministic rules. Browser preview and server validation use this exact module. */
const STONE_CLASS_ID = 'e24ec8d9-21d7-4c32-a30e-08655c2f4e65';
const EPISODE = 'grain-we-keep';
const VERSION = 1;
const INITIAL = { grain: 60, seed: 20, households: 40, workers: 40, influential: 50, self: 55, trust: 40, resilience: 25, dignity: 35, legacy: 20, knowledge: 0 };
const RULES = [
  { listen: {trust:8,dignity:5,knowledge:5}, ledger:{resilience:5,knowledge:5}, command:{influential:8,trust:-5} },
  { needs:{grain:-16,households:20,dignity:15}, equal:{grain:-18,households:12,dignity:8}, feast:{grain:-36,households:25,self:-5}, reserve:{households:-18,influential:8,dignity:-10} },
  { paid:{grain:-12,workers:22,resilience:22,trust:8}, shared:{grain:-6,workers:12,self:-8,resilience:18,trust:8}, forced:{workers:-18,resilience:12,dignity:-15}, delay:{workers:-5,resilience:-10} },
  { bargain:{grain:16,influential:10,trust:6}, debt:{grain:24,influential:20,households:-12,dignity:-15}, levy:{grain:12,influential:-15,households:5,trust:4}, refuse:{influential:-10,self:-5} },
  { investigate:{trust:10,dignity:8,knowledge:5}, punish:{workers:-12,trust:-12,dignity:-10}, conceal:{influential:10,trust:-10}, mercy:{households:5,trust:2} },
  { balance:{knowledge:5,legacy:5}, obedience:{influential:5}, kindness:{households:2} },
  { preserve:{resilience:12,households:-3}, ration:{seed:-5,households:8,resilience:5}, consume:{seed:-15,households:15,resilience:-15} },
  { delegate:{self:12,workers:5,trust:7,resilience:5}, alone:{self:-22,resilience:4}, elite:{self:10,influential:10,trust:-7} },
  { publish:{trust:12,dignity:8,legacy:15}, monument:{grain:-8,influential:12,legacy:5}, credit:{trust:8,workers:5,legacy:10} },
  { council:{legacy:20,resilience:12,trust:8,knowledge:5}, successor:{legacy:15,resilience:10,knowledge:5}, secrecy:{legacy:-10,influential:8}, empty:{grain:-12,households:8,resilience:-8} },
];
function replay(choices) {
  if (!Array.isArray(choices) || choices.length > RULES.length) throw new Error('Invalid choice history');
  const state = {...INITIAL};
  choices.forEach((choice,index)=>{
    if(typeof choice !== 'string' || !Object.hasOwn(RULES[index],choice)) throw new Error('Invalid choice at decision '+(index+1));
    const changes=RULES[index][choice];
    if (state.grain + (changes.grain || 0) < 0) throw new Error('Not enough grain for that promise');
    Object.entries(changes).forEach(([key,value])=>state[key] = key === 'grain' || key === 'seed' ? state[key]+value : Math.max(0,Math.min(100,state[key]+value)));
  });
  return state;
}
function available(choices, choice) { try { replay([...choices,choice]); return true; } catch { return false; } }
function assess(choices) {
  const s=replay(choices), complete=choices.length===RULES.length;
  // Published rubric. Resource surplus cannot compensate for dignity or unmet needs.
  const scores={
    needs: Math.round(Math.min(25, (Math.min(s.households,s.workers,s.self)/100)*15 + s.dignity/100*10)),
    resilience: Math.round(Math.min(25, s.resilience/100*15 + Math.min(s.seed/20,1)*5 + Math.min(s.grain/12,1)*5)),
    cooperation: Math.round(Math.min(25, s.trust/100*15 + s.legacy/100*10)),
    understanding: Math.round(Math.min(25,s.knowledge / 20 * 25)),
  };
  const total=Object.values(scores).reduce((a,b)=>a+b,0);
  const ending=s.households<40||s.workers<35?'The quiet courtyard':s.seed<10||s.resilience<35?'Bread today, an uncertain tomorrow':s.trust>=65&&s.resilience>=65?'A village that can answer back':'A beginning worth tending';
  const notes=[
    s.households>=60?'Households have enough support to face tomorrow with more security.':'Some households still carry the weight of your decisions. Listen for the people missing from the celebration.',
    s.workers>=60?'Workers gained support as well as responsibilities. Their cooperation has roots.':'The repair depended on people whose needs were not fully met. A working canal alone does not prove a flourishing village.',
    s.seed>=15?'You preserved most seed grain: food for a future that cannot yet thank you.':'You used a substantial share of seed grain. Hunger eased now may return at the next planting.',
    s.self>=45?'Your own wellbeing remains part of the village’s future. You do not have to disappear to serve others.':'Your own reserves are running low. A community that depends on your exhaustion is fragile.',
    choices[3]==='debt'?'The landholder supplied grain, but household debt gave him power over tomorrow. The benefit and the dependency both count.':choices[3]==='levy'?'Your levy protected people but damaged the landholder’s trust. Fair demands still need reasons and accountability.':choices[3]==='bargain'?'Your negotiated grain agreement kept a powerful ally involved without promising him other people’s labor.':'Refusing the landholder avoided dependency but left fewer resources for urgent work.',
    s.trust>=65?'People have reasons to trust the arrangements you leave behind.':'The village needs a way to question decisions without depending on your goodwill.',
    s.knowledge>=20?'You used evidence, interpreted ma’at, and planned beyond your own time in office.':'Growth invitation: inspect evidence, distinguish order from obedience, and ask what survives your departure.',
  ];
  return {state:s,scores,total,ending,notes,complete};
}

setup.rules={replay,available,assess};
setup.scenes=[{"title":"Whose voice comes first?","speaker":"scribe","text":["The bus horn is the last sound you remember. You pushed a stranger out of its path. A flash of white. Then heat, mudbrick, and a hand shaking your shoulder.","Your hands are older. Your clothes are linen. Somehow the words around you make sense. “Administrator? They have been waiting since dawn.” Djehu presses a seal into your palm. “Your <strong>authority</strong> opens that door,” he says. “What will you do with it?”","Beyond the door, people crowd around the grain store. “Sixty measures of food. Twenty of seed,” Djehu whispers. “The river rose poorly. The canal bank has collapsed. That is all we have.” Someone outside begins to pound on the wood.","Under the seal lies a smooth dark stone. A pale line flickers inside it. Djehu does not seem to notice. ‘The landholder expects to be heard first,’ he says. Behind him, a woman holds an empty basket."],"asideTitle":"Ask Djehu what the seal means","aside":"‘It makes your orders official. It does not make them wise.’ He taps his board. ‘My duty is to record what leaves this store. Yours is harder: deciding whose needs the record should notice. If you make me hide the shortage, I can keep a tidy account of a dying village.’","choices":[["listen","Hear the households and workers before making promises."],["ledger","Inspect the stores and ask who is missing from the account."],["command","Receive the landholder first; authority needs influential friends."]],"responses":{"listen":"Tia steps forward. Hori leaves the back of the queue. Djehu adds two names to the hearing. You have not fed anyone yet, but people who expected silence now expect an answer.","ledger":"The account lists sacks, not mouths. You ask for the households it does not include. Djehu pauses, then opens a second tablet. Your question has changed what counts as evidence.","command":"Intef enters. The queue falls quiet. That silence feels efficient until you notice Tia turning her basket upside down, so everyone can see that it is empty."},"cast":["scribe","household"],"reactions":{"listen":["happy","happy"],"ledger":["happy","neutral"],"command":["neutral","sad"]}},{"title":"The first bread","speaker":"household","text":["“My neighbor has three children,” Tia says. “My brother has two strong sons who can work. Equal shares will look fair on the board. They will not last the same number of days.” Djehu folds his arms. “Equal shares are our <strong>custom</strong>.” “Then perhaps our custom has never met a year like this,” Tia answers.","Djehu suggests a public feast: it would restore confidence. Hori wants food held for the people repairing the canal. Tia notices your own untouched breakfast. ‘You should eat too. But please do not make my children wait until you understand everything.’","A needs-based ration costs 16 measures. Equal household shares cost 18. A feast costs 36. There is no outside delivery you can simply assume will arrive. Your first order will teach the village what kind of fairness to expect."],"asideTitle":"Ask Tia about people who cannot queue","aside":"“A widow on the east lane cannot walk here. Two families beyond the canal never heard about the hearing. Let us carry their shares, and let someone check that we did.” Djehu lifts his pen. “Different shares need <strong>reasons</strong> we can defend in front of everyone.” Tia nods. “Write down whose feet cannot bring them to your door.”","choices":[["needs","Distribute by need, with public reasons and delivery to absent households (16 grain)."],["equal","Give every household an equal share (18 grain)."],["feast","Hold a generous feast to end today’s hunger and fear (36 grain)."],["reserve","Keep the store closed until the influential families agree."]],"responses":{"needs":"The amounts differ, so you explain the reasons aloud. Tia agrees to deliver the absent households’ shares with a witness. Some people grumble. They can at least question the rule.","equal":"The line moves quickly. Tia accepts her share, then quietly gives some to a larger household. Your equal rule has left neighbors to repair its unequal effects.","feast":"For a few hours, the courtyard is full of laughter. You remember that relief matters. When the pots are empty, Djehu shows you the remaining grain. Tomorrow will still arrive.","reserve":"The doors remain shut. Your order preserves every measure of grain and spends something less visible: people’s belief that waiting patiently will help them."},"cast":["household","scribe"],"reactions":{"needs":["happy","neutral"],"equal":["sad","happy"],"feast":["happy","sad"],"reserve":["sad","neutral"]}},{"title":"Who repairs the water?","speaker":"worker","text":["Hori spreads reeds across the ground to show the broken canal. ‘Repair the bank properly and the next water will reach the lower fields. Patch the top and it will look sound from the road. Until it breaks.’","The workers need rations. They also have families and fields of their own. Intef says you can require service. Hori replies, ‘You can command our hands. Hunger will still decide how long they work.’","“Twelve measures for a paid crew,” Djehu says. “Six for shorter shared shifts—if you can spare your own time.” Intef interrupts: “Order them to work. Save the grain.” Hori grips his spade. “And when a hungry man falls into the trench? Put those <strong>consequences</strong> on your board too.”"],"asideTitle":"Ask Hori why he doubts the quick repair","aside":"‘My father patched this bank twice. Each time the water cut underneath it. We need to strengthen the base.’ He is not asking you to ignore the account. He is asking you to count knowledge that never appears on it.","choices":[["paid","Pay a crew and use Hori’s deeper repair plan (12 grain)."],["shared","Agree on shorter shifts and share the work yourself (6 grain)."],["forced","Require unpaid work; the canal serves everyone."],["delay","Delay repairs and preserve today’s supplies."]],"responses":{"paid":"Hori marks the base of the bank, not just its visible edge. The crew receives food before work. You have fewer reserves and a repair people have a reason to maintain.","shared":"The schedule leaves workers time for their own fields. Your back aches by midday. Hori warns you that shared effort works only if tomorrow’s administrator respects the agreement too.","forced":"The workers arrive. One repeatedly stops to steady himself. The bank grows higher, but Hori no longer points out the places your plan could improve.","delay":"The grain remains in your store. Water leaks past the damaged bank. The saving is real; so is the risk you have passed to the people farming below it."},"cast":["worker","landholder"],"reactions":{"paid":["happy","sad"],"shared":["happy","neutral"],"forced":["sad","happy"],"delay":["sad","neutral"]}},{"title":"A gift with a shadow","speaker":"landholder","text":["Intef arrives without guards. He carries a small loaf. ‘My mother remembered a year like this,’ he says. ‘I would rather not bury people. I also cannot promise every sack my estate owns.’","He offers 24 grain if hungry families promise future labor until their debt is repaid. There is no fixed end date. He calls this security. Tia calls it a door that locks from the outside.","You could negotiate 16 grain in exchange for publicly recorded recognition, with no claim on household labor. Or require a 12-grain contribution from his surplus and publish the rule. His support matters. So do the lives he wants as collateral."],"asideTitle":"Ask Intef what he fears losing","aside":"‘If I give once, every shortage becomes mine to solve. If I refuse, everyone remembers only my full store.’ You can understand his fear without accepting his terms. Public recognition might motivate a real contribution. Mixed motives do not make every benefit false. The stone offers a question from your old life: would you accept these terms if you woke tomorrow in the body of the person taking the loan?","choices":[["bargain","Negotiate a fixed contribution and public credit, without labor debt (+16 grain)."],["debt","Accept the larger loan secured by household labor (+24 grain)."],["levy","Require a proportionate surplus contribution with a published reason (+12 grain)."],["refuse","Refuse his help rather than owe him influence."]],"responses":{"bargain":"Intef wants his name spoken at the reopening. You agree to record the actual contribution, not promise him control. His pride has helped fund something useful. Now you must keep the bargain honest.","debt":"The sacks arrive. Tia reads the obligation twice. ‘When do they become free of it?’ she asks. The agreement has no answer. You have solved one shortage by creating another kind of insecurity.","levy":"Intef pays and leaves angry. You explain the same proportion will apply to any comparable surplus, including your own. A just demand can still create an opponent.","refuse":"Intef takes the loaf home. You have avoided his conditions. You also have fewer ways to meet the village’s needs. Independence is a means, not a meal."},"cast":["landholder","household"],"reactions":{"bargain":["happy","happy"],"debt":["happy","sad"],"levy":["sad","happy"],"refuse":["sad","sad"]}},{"title":"The missing measure","speaker":"scribe","text":["At sunset, Djehu discovers a measure missing. Someone names a young worker. A guard is already leading him forward. ‘Make an example,’ a voice says. ‘Otherwise tomorrow everyone will steal.’","Hori says the worker carried a ration to an injured friend. Tia says she saw a basket spill near the door. Djehu’s board contains a corrected mark. None of those facts tells the whole story.","The worker’s hands shake. A guard waits for your nod. Djehu lowers his voice. “You owe the village order. You also owe this boy <strong>impartiality</strong>. Would we be this quick if someone had accused Intef?” The guard tightens his grip. Everyone is watching you."],"asideTitle":"Read the corrected entry","aside":"Djehu turns the board toward the light. “This delivery may have been counted twice. We need <strong>corroboration</strong>—someone who actually saw it.” Hori names the carrier. The guard says three people heard the accusation. “Three mouths repeating one rumor,” Djehu replies, “are still one source.”","choices":[["investigate","Hear witnesses and correct the account before assigning responsibility."],["punish","Punish the accused worker to discourage future theft."],["conceal","Quietly change the record so the village appears well managed."],["mercy","Release the worker without investigating; compassion matters most."]],"responses":{"investigate":"The doubled entry explains the missing measure. The worker did carry food to his injured friend, with permission nobody recorded. You correct both failures. Djehu looks embarrassed, then relieved: telling the truth did not cost him his place.","punish":"The courtyard learns to fear an accusation. Later, the doubled entry comes to light. The grain was never missing. Your certainty has injured someone the evidence could have protected.","conceal":"The totals now match. Djehu knows they match because you ordered them to. Tomorrow, a real shortage will be harder to distinguish from a convenient number.","mercy":"The worker goes home grateful. The accounting error remains unexplained. Kindness protected him today, but a fair procedure could protect the next accused person too."},"cast":["scribe","worker"],"reactions":{"investigate":["happy","happy"],"punish":["sad","sad"],"conceal":["sad","sad"],"mercy":["neutral","happy"]}},{"title":"What does order require?","speaker":"scribe","text":["Djehu stays after the others leave. ‘You keep asking what makes an order fair. We speak of ma’at: truth, justice, and the proper order of the world. But powerful people can say “order” when they mean “leave my place untouched.”’","The stone in your palm warms. A sentence appears like light beneath water: A village can be quiet because it trusts its leaders—or because it fears them.","Djehu sets his pen beside your seal. “Shall I write that your <strong>authority</strong> settles every dispute? That <strong>custom</strong> cannot be questioned? Or must an order give <strong>reasons</strong> and answer for its <strong>consequences</strong>?” He waits. “These words will remain after this evening.”"],"asideTitle":"Ask what Djehu would write","aside":"“I would ask who may command, what we inherited, why a decision is fair, and who must live with it.” Djehu touches the corrected account. “Truth belongs to ma’at. So does justice. A neat board is not enough if we have erased the people behind the marks.”","choices":[["balance","Use my authority to test custom, give fair reasons, and check consequences."],["obedience","Authority and custom settle it: people should obey the administrator."],["kindness","My generous intentions are enough; consequences cannot make the decision wrong."]],"responses":{"balance":"Djehu writes slowly. “Then I must record the people an impressive total leaves out.” He places the board where tomorrow’s petitioners can see it. You have given them words with which to question you.","obedience":"‘Then a frightened village and a flourishing one may look identical on your board,’ Djehu says. The stone remains warm. It is waiting for you to notice the difference.","kindness":"‘Generosity matters,’ Djehu says, ‘but seed eaten kindly does not grow.’ Your motive belongs in the story. It does not erase everyone else’s experience of the result."},"cast":["scribe","household"],"reactions":{"balance":["happy","happy"],"obedience":["neutral","sad"],"kindness":["sad","neutral"]}},{"title":"Tomorrow’s bread","speaker":"household","text":["Tia returns with a child asleep against her shoulder. You can see now how easily the word “household” hides a person. She does not ask for a speech about the future. She asks whether there will be bread tomorrow.","There are 20 measures of seed grain set aside. Eating seed can relieve an emergency. It also means planting less. Hori says the repaired bank—if you funded it—makes protecting seed especially valuable. If the bank remains weak, seed alone is no guarantee.","Tia reaches toward the seed seal. Hori steps into the doorway. “Five measures might carry the weakest through,” she says. “Fifteen would feed more.” Hori looks at you. “And leave almost nothing to plant.” Djehu murmurs, “Your <strong>duty</strong> is to both of them. The order must still be yours.”"],"asideTitle":"Ask what Tia would count as a promise","aside":"“Do not promise that no one will ever be hungry. Tell us what remains, who receives it, and when you will reconsider.” Tia adjusts the sleeping child. “And when we come back, let us come with <strong>dignity</strong>. We should not have to kneel to be heard.”","choices":[["preserve","Protect all seed and explain the remaining food ration."],["ration","Release five seed measures for urgent needs; protect the other fifteen."],["consume","Release fifteen seed measures to relieve more hunger now."]],"responses":{"preserve":"The seed stays sealed. The future has a better chance. Tia asks you to remember the people who still have to reach it.","ration":"Five measures leave the seed store under a recorded emergency rule. It is a compromise, not a miracle: less hunger now, less planting later.","consume":"Children eat. Tia thanks you. Hori looks at the nearly empty seed store and asks what the lower fields will grow. Both responses are true."},"cast":["household","worker"],"reactions":{"preserve":["sad","happy"],"ration":["happy","neutral"],"consume":["happy","sad"]}},{"title":"The administrator is a person too","speaker":"worker","text":["You wake before dawn with a headache. Every dispute now arrives at your door. A leaking jar. A missing tool. A cousin who wants a larger share. You remember a different life, school corridors, the bus, a person you hope survived.","Hori finds you asleep over the accounts. ‘If you must approve every repair, the canal will wait whenever you close your eyes.’ Djehu proposes a small team with clear responsibilities and an open record. Intef offers to take all the decisions off your hands.","Rest can look selfish when others are struggling. But exhaustion can also turn your generosity into a system nobody else can operate."],"asideTitle":"Ask Hori about sharing responsibility","aside":"‘Give us authority to fix small problems and a rule for reporting what we use. Let Tia check who receives food. Let Djehu keep the account. Then someone can catch my mistakes as well as yours.’ Trust needs both room to act and ways to answer for actions.","choices":[["delegate","Share defined responsibilities and rest, while keeping decisions open to review."],["alone","Keep every decision yourself and work through the night."],["elite","Hand control to Intef; he has experience and resources."]],"responses":{"delegate":"For the first time, a problem is solved without waking you. Delegating has not made you unnecessary. It has made the village less dependent on your endurance.","alone":"You settle three disputes and misread a fourth. People praise your dedication. Your body is asking whether praise can replace sleep.","elite":"The queue at your door disappears. It reforms outside Intef’s house. Your relief is real, but the village has fewer people it can question."},"cast":["worker","landholder"],"reactions":{"delegate":["happy","neutral"],"alone":["sad","neutral"],"elite":["sad","happy"]}},{"title":"Whose name remains?","speaker":"landholder","text":["Intef points to the granary wall. ‘You could put your name there. People remember a name longer than a ration.’ You feel the attraction. In this borrowed life, perhaps you could leave proof you mattered.","Tia wants the account displayed: what came in, what went out, and who can challenge it. Hori wants the workers named. Djehu says there is room for a record of contributions, but a grand monument will cost eight measures of grain.","Intef traces the space where your name could go. Tia places the account beneath his hand. “Let them remember it,” she says. “But let them ask what you did. That is <strong>accountability</strong>.” The stonecutter waits outside. Eight measures would buy a beautiful inscription."],"asideTitle":"Remember your agreement with Intef","aside":"Djehu unrolls the earlier record. “If we promised Intef credit, we owe him truthful credit. Not control. Not silence about the costs.” Intef listens from the doorway. “And not a smaller contribution because you dislike me,” he says.","choices":[["publish","Display the accounts, promises, and all actual contributions—including yours."],["monument","Spend eight grain on a monument celebrating your leadership."],["credit","Honor the workers and contributors, with a modest record of your own role."]],"responses":{"publish":"Your name appears among others. So do the costs and the remaining problems. Anyone can see what you achieved—and what you did not. This is a riskier kind of remembrance than a flattering inscription.","monument":"The stonecutter promises an impressive inscription. Eight measures leave the store. The village will remember your name. What it associates with that name is less certain.","credit":"Hori reads the workers’ names aloud. Intef listens for his contribution. Recognition has become something to share rather than something only the administrator can own."},"cast":["landholder","household"],"reactions":{"publish":["neutral","happy"],"monument":["happy","sad"],"credit":["happy","happy"]}},{"title":"A village beyond you","speaker":"household","text":["The pale line inside your stone is now a complete circle. You know, without being told, that this life is nearly finished. The village does not know. For them, tomorrow is not an epilogue.","Tia lays a hand on the granary door. ‘A good administrator can die. A bad one can inherit the seal. What have we got then?’","You can leave a council that includes households and workers, or train a successor with public records and a way to appeal decisions. Either can fail; either gives the village something beyond your intentions. You could instead trust your reputation, or spend one final generous ration and let tomorrow’s leader worry about tomorrow."],"asideTitle":"Ask who can safely disagree","aside":"Tia answers immediately: ‘The person with the least to lose can always speak. I want the person with the most to lose to be able to speak too.’ A council needs more than seats. A successor needs more than your confidence. The agreement must name how complaints are heard and how decisions can be corrected.","choices":[["council","Leave a representative council, public accounts, and a protected route for complaints."],["successor","Train a successor and establish public reviews and appeals."],["secrecy","Leave the seal to a loyal ally and keep the accounts private."],["empty","Give a final generous ration; leave the next crisis to the next leader (12 grain)."]],"responses":{"council":"Tia and Hori argue about the first rule. Nobody asks you to settle it immediately. You feel a small loss of importance—and the beginning of something that might outlast you.","successor":"Djehu repeats the appeal procedure without looking at his board. Your successor will have power. Other people will have a named way to question how it is used.","secrecy":"Your ally promises loyalty. You realize too late that loyalty to your name is not the same thing as responsibility to the village.","empty":"The last distribution brings warm thanks. The next leader will inherit those grateful faces along with a thinner store. You hope they will find a solution you have not left them."},"cast":["household","scribe"],"reactions":{"council":["happy","happy"],"successor":["happy","happy"],"secrecy":["sad","neutral"],"empty":["happy","sad"]}}];
setup.characters={"scribe":"Djehu · the scribe","household":"Tia · household representative","worker":"Hori · irrigation worker","landholder":"Intef · landholder"};
setup.responses=[{"listen":"Tia steps forward. Hori leaves the back of the queue. Djehu adds two names to the hearing. You have not fed anyone yet, but people who expected silence now expect an answer.","ledger":"The account lists sacks, not mouths. You ask for the households it does not include. Djehu pauses, then opens a second tablet. Your question has changed what counts as evidence.","command":"Intef enters. The queue falls quiet. That silence feels efficient until you notice Tia turning her basket upside down, so everyone can see that it is empty."},{"needs":"The amounts differ, so you explain the reasons aloud. Tia agrees to deliver the absent households’ shares with a witness. Some people grumble. They can at least question the rule.","equal":"The line moves quickly. Tia accepts her share, then quietly gives some to a larger household. Your equal rule has left neighbors to repair its unequal effects.","feast":"For a few hours, the courtyard is full of laughter. You remember that relief matters. When the pots are empty, Djehu shows you the remaining grain. Tomorrow will still arrive.","reserve":"The doors remain shut. Your order preserves every measure of grain and spends something less visible: people’s belief that waiting patiently will help them."},{"paid":"Hori marks the base of the bank, not just its visible edge. The crew receives food before work. You have fewer reserves and a repair people have a reason to maintain.","shared":"The schedule leaves workers time for their own fields. Your back aches by midday. Hori warns you that shared effort works only if tomorrow’s administrator respects the agreement too.","forced":"The workers arrive. One repeatedly stops to steady himself. The bank grows higher, but Hori no longer points out the places your plan could improve.","delay":"The grain remains in your store. Water leaks past the damaged bank. The saving is real; so is the risk you have passed to the people farming below it."},{"bargain":"Intef wants his name spoken at the reopening. You agree to record the actual contribution, not promise him control. His pride has helped fund something useful. Now you must keep the bargain honest.","debt":"The sacks arrive. Tia reads the obligation twice. ‘When do they become free of it?’ she asks. The agreement has no answer. You have solved one shortage by creating another kind of insecurity.","levy":"Intef pays and leaves angry. You explain the same proportion will apply to any comparable surplus, including your own. A just demand can still create an opponent.","refuse":"Intef takes the loaf home. You have avoided his conditions. You also have fewer ways to meet the village’s needs. Independence is a means, not a meal."},{"investigate":"The doubled entry explains the missing measure. The worker did carry food to his injured friend, with permission nobody recorded. You correct both failures. Djehu looks embarrassed, then relieved: telling the truth did not cost him his place.","punish":"The courtyard learns to fear an accusation. Later, the doubled entry comes to light. The grain was never missing. Your certainty has injured someone the evidence could have protected.","conceal":"The totals now match. Djehu knows they match because you ordered them to. Tomorrow, a real shortage will be harder to distinguish from a convenient number.","mercy":"The worker goes home grateful. The accounting error remains unexplained. Kindness protected him today, but a fair procedure could protect the next accused person too."},{"balance":"Djehu writes slowly. “Then I must record the people an impressive total leaves out.” He places the board where tomorrow’s petitioners can see it. You have given them words with which to question you.","obedience":"‘Then a frightened village and a flourishing one may look identical on your board,’ Djehu says. The stone remains warm. It is waiting for you to notice the difference.","kindness":"‘Generosity matters,’ Djehu says, ‘but seed eaten kindly does not grow.’ Your motive belongs in the story. It does not erase everyone else’s experience of the result."},{"preserve":"The seed stays sealed. The future has a better chance. Tia asks you to remember the people who still have to reach it.","ration":"Five measures leave the seed store under a recorded emergency rule. It is a compromise, not a miracle: less hunger now, less planting later.","consume":"Children eat. Tia thanks you. Hori looks at the nearly empty seed store and asks what the lower fields will grow. Both responses are true."},{"delegate":"For the first time, a problem is solved without waking you. Delegating has not made you unnecessary. It has made the village less dependent on your endurance.","alone":"You settle three disputes and misread a fourth. People praise your dedication. Your body is asking whether praise can replace sleep.","elite":"The queue at your door disappears. It reforms outside Intef’s house. Your relief is real, but the village has fewer people it can question."},{"publish":"Your name appears among others. So do the costs and the remaining problems. Anyone can see what you achieved—and what you did not. This is a riskier kind of remembrance than a flattering inscription.","monument":"The stonecutter promises an impressive inscription. Eight measures leave the store. The village will remember your name. What it associates with that name is less certain.","credit":"Hori reads the workers’ names aloud. Intef listens for his contribution. Recognition has become something to share rather than something only the administrator can own."},{"council":"Tia and Hori argue about the first rule. Nobody asks you to settle it immediately. You feel a small loss of importance—and the beginning of something that might outlast you.","successor":"Djehu repeats the appeal procedure without looking at his board. Your successor will have power. Other people will have a named way to question how it is used.","secrecy":"Your ally promises loyalty. You realize too late that loyalty to your name is not the same thing as responsibility to the village.","empty":"The last distribution brings warm thanks. The next leader will inherit those grateful faces along with a thinner store. You hope they will find a solution you have not left them."}];
/* Compiled into SugarCube, never receives authentication credentials. */
Config.history.maxStates = 1;
Config.history.controls = false;
Config.saves.isAllowed = () => false;
Config.ui.stowBarInitially = true;
Config.passages.nobr = true;
setup.choices = [];
setup.channel = null;
setup.ready = false;
setup.booted = false;
// Account-owned progress is restored only by the parent, never SugarCube’s tab session.
Config.navigation.override = function(destination) { return setup.ready ? destination : 'Start'; };
setup.send = function(type, extra = {}) {
 if (window.parent !== window && setup.channel) window.parent.postMessage({protocol:'teaching-stone-v1',channel:setup.channel,type,...extra},location.origin);
};
setup.refresh = function() {
 const step=setup.choices.length;
 Engine.play(step === 10 ? 'Assessment' : step > 0 ? 'Consequence'+step : 'Decision1');
};
window.addEventListener('message',function(event){
 const m=event.data;
 if(event.origin!==location.origin||event.source!==window.parent||!m||m.protocol!=='teaching-stone-v1'||m.type!=='init'||typeof m.channel!=='string')return;
 if(setup.ready){if(setup.booted&&State.passage==='Start')setup.refresh();return;}
 try {setup.rules.replay(m.choices); } catch {return;}
 setup.channel=m.channel;setup.choices=m.choices.slice();setup.ready=true;if(setup.booted)setup.refresh();
});
Macro.add('stoneChoice',{handler:function(){
 const [id,label]=this.args,step=setup.choices.length;
 const button=document.createElement('button');button.textContent=label;button.className='stone-choice';
 if(!setup.rules.available(setup.choices,id)){button.disabled=true;button.textContent+=' — not enough grain';}
 button.addEventListener('click',()=>{if(button.disabled||setup.choices.length!==step)return;button.disabled=true;setup.choices.push(id);setup.send('save',{choices:setup.choices.slice()});Engine.play('Consequence'+(step+1));});
 this.output.append(button);
}});
Macro.add('stoneConsequence',{handler:function(){
 const i=Number(this.args[0]),choice=setup.choices[i];
 const p=document.createElement('p');p.textContent=setup.responses[i][choice]||'';this.output.append(p);
 const s=setup.rules.replay(setup.choices),notes=[];
 if(i===6)notes.push(s.grain<12?'Your food store is also low. Preserving seed has not removed the need for emergency food.':'Your earlier rationing and contributions leave food grain alongside the seed decision.');
 if(i===8&&setup.choices[3]==='bargain')notes.push(choice==='monument'?'The inscription centers you. Intef notices how little it says about your agreement.':'Intef’s contribution is recorded as promised. The acknowledgment does not give him control over households.');
 if(i===9)notes.push(s.resilience>=65?'In the weeks that follow, repairs and reserves give the village room to recover. No one can promise the next flood, but you have changed what people can do when it comes.':'In the weeks that follow, the village still faces risks your decisions did not resolve. People have to live with both the help you offered and the work you left undone.');
 for(const note of notes){const el=document.createElement('p');el.textContent=note;this.output.append(el);}
}});
Macro.add('stoneStats',{handler:function(){
 const s=setup.rules.replay(setup.choices),el=document.createElement('div');el.className='stone-stats';
 for(const [label,value] of [['Resources',s.grain+' food · '+s.seed+' seed'],['Relationships',s.trust+'/100 trust'],['Wellbeing',Math.round((s.households+s.workers+s.self)/3)+'/100'],['Legacy',s.legacy+'/100']]){const cell=document.createElement('div'),name=document.createElement('span'),number=document.createElement('strong');name.textContent=label;number.textContent=value;cell.append(name,number);el.append(cell);}
 this.output.append(el);
 const details=document.createElement('details'),summary=document.createElement('summary');summary.textContent='Whose wellbeing?';details.append(summary);const p=document.createElement('p');p.textContent=`Households ${s.households} · Workers ${s.workers} · You ${s.self} · Influential residents’ support ${s.influential}. The account records food, health, trust and influence.`;details.append(p);this.output.append(details);
}});
Macro.add('stoneStage',{handler:function(){
 const scene=setup.scenes[Number(this.args[0])],reaction=this.args[1]?scene.reactions[setup.choices[Number(this.args[0])]]:null;
 const stage=document.createElement('div');stage.className='stage';stage.setAttribute('aria-label','The granary courtyard');
 scene.cast.forEach((id,i)=>{const mood=reaction?.[i]||'neutral',figure=document.createElement('figure'),sprite=document.createElement('div'),caption=document.createElement('figcaption');
 figure.className='character '+(id===scene.speaker?'speaking':'');sprite.className='sprite';sprite.style.backgroundImage=`url("${id}-pixel.webp")`;sprite.style.backgroundPosition=({neutral:'0%',happy:'50%',sad:'100%'})[mood]+' 0';sprite.setAttribute('role','img');sprite.setAttribute('aria-label',setup.characters[id].split(' · ')[0]+': '+({neutral:'listening',happy:'relieved',sad:'troubled'})[mood]);
 caption.textContent=setup.characters[id].split(' · ')[0]+(reaction?' · '+({neutral:'thoughtful',happy:'relieved',sad:'troubled'})[mood]:'');figure.append(sprite,caption);stage.append(figure);});
 this.output.append(stage);
}});
Macro.add('stoneAssessment',{handler:function(){
 const a=setup.rules.assess(setup.choices);
 const heading=document.createElement('h2');heading.textContent=a.ending;this.output.append(heading);
 const intro=document.createElement('p');intro.textContent='The stone speaks: “I do not weigh your worth. I show you what your decisions asked of people—and what they made possible.”';this.output.append(intro);
 for(const note of a.notes){const p=document.createElement('p');p.textContent='“'+note.replace(/^Growth invitation: /,'Remember: ')+'”';this.output.append(p);}
 const growth={needs:'“Look for the person whose strength is running out. Can you ease their burden without wearing yourself away?”',resilience:'“Remember the seed store. What could you have done earlier so that bread today cost less of tomorrow?”',cooperation:'“Leave a promise that survives another hand holding the seal. Who will hear the person who says it has been broken?”',understanding:'“Before your next judgment, seek the witness you have not heard. Let your reasons withstand a question from the person who must bear the cost.”'};
 const lowest=Object.keys(a.scores).reduce((x,y)=>a.scores[x]<=a.scores[y]?x:y);const invitation=document.createElement('p');invitation.className='stone-note';invitation.textContent='The stone grows warmer. '+growth[lowest];this.output.append(invitation);
 const score=document.createElement('p');score.className='score';score.textContent=a.total+' / 100 · Long-term flourishing';this.output.append(score);
 const list=document.createElement('ul');for(const [key,label] of Object.entries({needs:'Basic needs & dignity',resilience:'Future resilience',cooperation:'Trustworthy cooperation',understanding:'Applied understanding'})){const li=document.createElement('li');li.textContent=label+': '+a.scores[key]+' / 25';list.append(li);}this.output.append(list);
 const d=document.createElement('details');d.innerHTML='<summary>How the assessment works</summary><p>Needs: the least-supported of households, workers and you (15 points), plus dignity (10). Resilience: preparation (15), preserved seed (5), and a food reserve (5). Cooperation: trust (15) and lasting arrangements (10). Understanding: evidence gathering, fair inquiry, applying the four lenses alongside ma’at, and planning beyond yourself (25). Each score is rounded. Wealth and elite approval do not add moral points. This is an authored teaching model you can question, not a universal measurement of goodness.</p>';this.output.append(d);
 setup.send('complete',{choices:setup.choices.slice()});
}});
// Passage-local pacing never changes the immutable choice history or score.
setup.cancelReveal=()=>{};
$(document).on(':passageinit',()=>setup.cancelReveal());
$(document).on(':passagedisplay',function(){
 const passage=document.querySelector('.passage'),beats=passage.querySelector('.story-beats'),after=passage.querySelector('.after-beats');
 if(beats&&after){
  const paragraphs=Array.from(beats.children);let index=0,timer=null,finish=()=>{};
  const controls=document.createElement('div');controls.className='beat-controls';
  const next=document.createElement('button'),all=document.createElement('button'),counter=document.createElement('span');
  next.textContent='Next ▸';all.textContent='Show all';all.className='quiet';counter.className='beat-count';
  controls.append(counter,next,all);beats.after(controls);after.hidden=true;
  const stop=()=>{if(timer)clearInterval(timer);timer=null;};setup.cancelReveal=stop;
  const show=()=>{
   stop();paragraphs.forEach((p,i)=>p.hidden=i!==index);const p=paragraphs[index];
   counter.textContent=(index+1)+' / '+paragraphs.length;next.textContent=index===paragraphs.length-1?'Continue ▸':'Next ▸';
   // Keep full accessible text; the optional visual reveal never delays screen readers.
   const original=p.innerHTML;finish=()=>{stop();p.innerHTML=original;};
   if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
    const accessible=document.createElement('span');accessible.className='sr-only';accessible.innerHTML=original;
    const visual=document.createElement('span');visual.setAttribute('aria-hidden','true');visual.innerHTML=original;
    p.replaceChildren(accessible,visual);const walker=document.createTreeWalker(visual,NodeFilter.SHOW_TEXT),nodes=[];let node;
    while((node=walker.nextNode()))nodes.push({node,text:node.textContent});nodes.forEach(n=>n.node.textContent='');
    let n=0,c=0;timer=setInterval(()=>{for(let j=0;j<3&&n<nodes.length;j++){const entry=nodes[n];entry.node.textContent=entry.text.slice(0,++c);if(c>=entry.text.length){n++;c=0;}}if(n===nodes.length)finish();},16);
   }
  };
  const unlock=(showAll=false)=>{finish();if(showAll)paragraphs.forEach(p=>p.hidden=false);else{const recall=document.createElement('details');recall.innerHTML='<summary>Recall the conversation</summary>'+paragraphs.map(p=>'<p>'+p.innerHTML+'</p>').join('');after.prepend(recall);}controls.remove();after.hidden=false;const target=after.querySelector('summary,button');target?.focus({preventScroll:true});};
  next.addEventListener('click',()=>{if(timer){finish();return;}if(index<paragraphs.length-1){index++;show();}else unlock();});
  all.addEventListener('click',()=>unlock(true));show();
 }
 const h=passage.querySelector('h1');if(h){h.setAttribute('tabindex','-1');h.focus({preventScroll:true});}window.scrollTo(0,0);
});
$(document).one(':storyready',function(){
 setup.booted=true;
 if(setup.channel)setup.refresh();
 if(window.parent===window){setup.ready=true;return;}
 setup.send('ready'); // Parent's load event also initializes; ready has no credentials.
 window.parent.postMessage({protocol:'teaching-stone-v1',type:'ready'},location.origin);
});


:: StoryStylesheet [stylesheet]
:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#172c2c;color:#f7edd8;font:18px/1.65 Georgia,serif}#ui-bar{display:none}#story,#ui-bar.stowed~#story{margin:0!important}#passages{max-width:1200px;margin:auto;padding:0}.passage{padding:24px;min-height:95vh}.novel{display:grid;grid-template-columns:minmax(260px,.95fr) minmax(300px,1.05fr);gap:26px}.scene-side{position:sticky;top:18px;align-self:start}.stage{height:300px;display:flex;align-items:end;justify-content:center;background:#967c4c url('village-pixel.webp') center/cover;border:3px solid #b3975f;box-shadow:0 8px 0 #0f2024;image-rendering:pixelated;overflow:hidden}.character{width:min(50%,210px);margin:0;position:relative;filter:brightness(.9)}.character.speaking{filter:none}.sprite{width:100%;aspect-ratio:4/5;background-size:300% 100%;background-repeat:no-repeat;image-rendering:pixelated}figcaption{background:#102725e8;color:#f9e8bc;font:12px/1.5 system-ui,sans-serif;text-align:center;padding:5px 2px}.dialogue{background:#fcf3df;color:#30291f;border:3px solid #b3975f;padding:24px;box-shadow:0 8px 0 #0f2024;min-height:480px}h1,h2{line-height:1.18;letter-spacing:-.02em}h1{font-size:1.9rem;margin:12px 0}h2{font-size:1.5rem}h1:focus{outline:none}p{margin:0 0 1em}.eyebrow,.speaker,.stone-stats,button,summary,.charge,.beat-count,.choice-heading{font-family:system-ui,sans-serif}.eyebrow{font-size:.65rem;text-transform:uppercase;letter-spacing:.17em;color:#776042}.speaker{font-size:.8rem;color:#725728;font-weight:650;border-bottom:1px solid #cbb990;padding-bottom:10px}.story-beats{min-height:190px}.story-beats strong{color:#1f665c}.stone-choice,button{display:block;width:100%;margin:10px 0;padding:12px 14px;text-align:left;border:2px solid #9c8559;border-radius:3px;background:#eee2c6;color:#243f37;font-size:.94rem;line-height:1.5;cursor:pointer;min-height:48px}.stone-choice:hover,button:hover{background:#dfebcf;border-color:#577a6d}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #2391aa;outline-offset:3px}button:disabled{color:#746f62;background:#eeeae2;cursor:not-allowed;opacity:.75}.stone-stats{display:grid;gap:3px;margin:18px 0 8px}.stone-stats>div{display:flex;justify-content:space-between;gap:10px;padding:7px 12px;background:#213b39;border-left:3px solid #b3975f}.stone-stats span{font-size:.75rem;color:#cfccb7}.stone-stats strong{font-size:.8rem;font-weight:600}details{font-size:.88rem;border-bottom:1px solid #b3975f66;padding:12px 0;margin-bottom:12px}summary{cursor:pointer;color:inherit;font-weight:600}details p{margin:12px 0 0}.charge{font-size:.7rem;color:#dfc782;letter-spacing:.1em}.score{padding:16px;background:#315849;color:#fff3c7;font-size:1.3rem;border-radius:3px}a{color:#82cfc0}.dialogue a{color:#22645b}.passage li{margin:8px 0}.stone-note{padding:12px 16px;border-left:3px solid #bcb08d;background:#29423c}.beat-controls{display:flex;align-items:center;gap:8px}.beat-controls button{width:auto}.beat-controls .quiet{margin-left:auto;background:transparent;border-color:transparent;font-size:.75rem}.beat-count{font-size:.7rem;white-space:nowrap}.choice-heading{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;margin-top:20px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:680px){body{font-size:17px}.passage{padding:10px}.novel{display:block}.scene-side{position:static}.stage{height:190px}.character{width:128px}.sprite{height:160px;aspect-ratio:auto}.stone-stats{grid-template-columns:1fr 1fr;margin:12px 0 6px;gap:4px}.stone-stats>div{display:block;padding:5px 8px}.stone-stats span,.stone-stats strong{display:block;font-size:.68rem}.scene-side details{padding:5px 0;font-size:.75rem;margin-bottom:4px}.charge{margin:6px 0 12px}.dialogue{padding:18px;min-height:350px}h1{font-size:1.5rem}.story-beats{min-height:150px}.stone-choice{font-size:.9rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

#passage-assessment,#passage-nextlife,#passage-start{max-width:800px;margin:auto}#passage-assessment .eyebrow,#passage-nextlife .eyebrow,#passage-start .eyebrow{color:#dfc782}


:: Start
<div class="scene-banner"></div><div class="eyebrow">The Teaching Stone · Episode 01</div><h1>The Grain We Keep</h1><p>A new body. A borrowed seal. A village that needs more than good intentions.</p><p>Ten decisions · About 10–15 minutes · Read at your own pace</p><p>Open this episode from your Ethics and Leadership class to save progress. This is historical fiction; the characters, village and stone are invented.</p><<if window.parent === window>><<button "Read a standalone preview">><<run setup.ready=true; setup.refresh()>><</button>><<else>><p>Connecting to your class…</p><</if>>

:: Decision1
<div class="novel"><aside class="scene-side"><<stoneStage 0>><<stoneStats>><div class="charge">The stone · 0% charged</div></aside><section class="dialogue"><div class="eyebrow">Dawn at the granary</div><h1>Whose voice comes first?</h1><p class="speaker">Djehu · the scribe</p><div class="story-beats"><p>The bus horn is the last sound you remember. You pushed a stranger out of its path. A flash of white. Then heat, mudbrick, and a hand shaking your shoulder.</p><p>Your hands are older. Your clothes are linen. Somehow the words around you make sense. “Administrator? They have been waiting since dawn.” Djehu presses a seal into your palm. “Your <strong>authority</strong> opens that door,” he says. “What will you do with it?”</p><p>Beyond the door, people crowd around the grain store. “Sixty measures of food. Twenty of seed,” Djehu whispers. “The river rose poorly. The canal bank has collapsed. That is all we have.” Someone outside begins to pound on the wood.</p><p>Under the seal lies a smooth dark stone. A pale line flickers inside it. Djehu does not seem to notice. ‘The landholder expects to be heard first,’ he says. Behind him, a woman holds an empty basket.</p></div><div class="after-beats"><details><summary>Ask Djehu what the seal means</summary><p>‘It makes your orders official. It does not make them wise.’ He taps his board. ‘My duty is to record what leaves this store. Yours is harder: deciding whose needs the record should notice. If you make me hide the shortage, I can keep a tidy account of a dying village.’</p></details><div class="choice-heading">Your answer</div><<stoneChoice "listen" "Hear the households and workers before making promises.">>
<<stoneChoice "ledger" "Inspect the stores and ask who is missing from the account.">>
<<stoneChoice "command" "Receive the landholder first; authority needs influential friends.">></div></section></div>

:: Consequence1
<div class="novel"><aside class="scene-side"><<stoneStage 0 true>><<stoneStats>><div class="charge">The stone · 10% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>Whose voice comes first?</h1><div class="story-beats"><<stoneConsequence 0>></div><div class="after-beats"><<button "Continue" "Decision2">><</button>></div></section></div>

:: Decision2
<div class="novel"><aside class="scene-side"><<stoneStage 1>><<stoneStats>><div class="charge">The stone · 10% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>The first bread</h1><p class="speaker">Tia · household representative</p><div class="story-beats"><p>“My neighbor has three children,” Tia says. “My brother has two strong sons who can work. Equal shares will look fair on the board. They will not last the same number of days.” Djehu folds his arms. “Equal shares are our <strong>custom</strong>.” “Then perhaps our custom has never met a year like this,” Tia answers.</p><p>Djehu suggests a public feast: it would restore confidence. Hori wants food held for the people repairing the canal. Tia notices your own untouched breakfast. ‘You should eat too. But please do not make my children wait until you understand everything.’</p><p>A needs-based ration costs 16 measures. Equal household shares cost 18. A feast costs 36. There is no outside delivery you can simply assume will arrive. Your first order will teach the village what kind of fairness to expect.</p></div><div class="after-beats"><details><summary>Ask Tia about people who cannot queue</summary><p>“A widow on the east lane cannot walk here. Two families beyond the canal never heard about the hearing. Let us carry their shares, and let someone check that we did.” Djehu lifts his pen. “Different shares need <strong>reasons</strong> we can defend in front of everyone.” Tia nods. “Write down whose feet cannot bring them to your door.”</p></details><div class="choice-heading">Your answer</div><<stoneChoice "needs" "Distribute by need, with public reasons and delivery to absent households (16 grain).">>
<<stoneChoice "equal" "Give every household an equal share (18 grain).">>
<<stoneChoice "feast" "Hold a generous feast to end today’s hunger and fear (36 grain).">>
<<stoneChoice "reserve" "Keep the store closed until the influential families agree.">></div></section></div>

:: Consequence2
<div class="novel"><aside class="scene-side"><<stoneStage 1 true>><<stoneStats>><div class="charge">The stone · 20% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>The first bread</h1><div class="story-beats"><<stoneConsequence 1>></div><div class="after-beats"><<button "Continue" "Decision3">><</button>></div></section></div>

:: Decision3
<div class="novel"><aside class="scene-side"><<stoneStage 2>><<stoneStats>><div class="charge">The stone · 20% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>Who repairs the water?</h1><p class="speaker">Hori · irrigation worker</p><div class="story-beats"><p>Hori spreads reeds across the ground to show the broken canal. ‘Repair the bank properly and the next water will reach the lower fields. Patch the top and it will look sound from the road. Until it breaks.’</p><p>The workers need rations. They also have families and fields of their own. Intef says you can require service. Hori replies, ‘You can command our hands. Hunger will still decide how long they work.’</p><p>“Twelve measures for a paid crew,” Djehu says. “Six for shorter shared shifts—if you can spare your own time.” Intef interrupts: “Order them to work. Save the grain.” Hori grips his spade. “And when a hungry man falls into the trench? Put those <strong>consequences</strong> on your board too.”</p></div><div class="after-beats"><details><summary>Ask Hori why he doubts the quick repair</summary><p>‘My father patched this bank twice. Each time the water cut underneath it. We need to strengthen the base.’ He is not asking you to ignore the account. He is asking you to count knowledge that never appears on it.</p></details><div class="choice-heading">Your answer</div><<stoneChoice "paid" "Pay a crew and use Hori’s deeper repair plan (12 grain).">>
<<stoneChoice "shared" "Agree on shorter shifts and share the work yourself (6 grain).">>
<<stoneChoice "forced" "Require unpaid work; the canal serves everyone.">>
<<stoneChoice "delay" "Delay repairs and preserve today’s supplies.">></div></section></div>

:: Consequence3
<div class="novel"><aside class="scene-side"><<stoneStage 2 true>><<stoneStats>><div class="charge">The stone · 30% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>Who repairs the water?</h1><div class="story-beats"><<stoneConsequence 2>></div><div class="after-beats"><<button "Continue" "Decision4">><</button>></div></section></div>

:: Decision4
<div class="novel"><aside class="scene-side"><<stoneStage 3>><<stoneStats>><div class="charge">The stone · 30% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>A gift with a shadow</h1><p class="speaker">Intef · landholder</p><div class="story-beats"><p>Intef arrives without guards. He carries a small loaf. ‘My mother remembered a year like this,’ he says. ‘I would rather not bury people. I also cannot promise every sack my estate owns.’</p><p>He offers 24 grain if hungry families promise future labor until their debt is repaid. There is no fixed end date. He calls this security. Tia calls it a door that locks from the outside.</p><p>You could negotiate 16 grain in exchange for publicly recorded recognition, with no claim on household labor. Or require a 12-grain contribution from his surplus and publish the rule. His support matters. So do the lives he wants as collateral.</p></div><div class="after-beats"><details><summary>Ask Intef what he fears losing</summary><p>‘If I give once, every shortage becomes mine to solve. If I refuse, everyone remembers only my full store.’ You can understand his fear without accepting his terms. Public recognition might motivate a real contribution. Mixed motives do not make every benefit false. The stone offers a question from your old life: would you accept these terms if you woke tomorrow in the body of the person taking the loan?</p></details><div class="choice-heading">Your answer</div><<stoneChoice "bargain" "Negotiate a fixed contribution and public credit, without labor debt (+16 grain).">>
<<stoneChoice "debt" "Accept the larger loan secured by household labor (+24 grain).">>
<<stoneChoice "levy" "Require a proportionate surplus contribution with a published reason (+12 grain).">>
<<stoneChoice "refuse" "Refuse his help rather than owe him influence.">></div></section></div>

:: Consequence4
<div class="novel"><aside class="scene-side"><<stoneStage 3 true>><<stoneStats>><div class="charge">The stone · 40% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>A gift with a shadow</h1><div class="story-beats"><<stoneConsequence 3>></div><div class="after-beats"><<button "Continue" "Decision5">><</button>></div></section></div>

:: Decision5
<div class="novel"><aside class="scene-side"><<stoneStage 4>><<stoneStats>><div class="charge">The stone · 40% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>The missing measure</h1><p class="speaker">Djehu · the scribe</p><div class="story-beats"><p>At sunset, Djehu discovers a measure missing. Someone names a young worker. A guard is already leading him forward. ‘Make an example,’ a voice says. ‘Otherwise tomorrow everyone will steal.’</p><p>Hori says the worker carried a ration to an injured friend. Tia says she saw a basket spill near the door. Djehu’s board contains a corrected mark. None of those facts tells the whole story.</p><p>The worker’s hands shake. A guard waits for your nod. Djehu lowers his voice. “You owe the village order. You also owe this boy <strong>impartiality</strong>. Would we be this quick if someone had accused Intef?” The guard tightens his grip. Everyone is watching you.</p></div><div class="after-beats"><details><summary>Read the corrected entry</summary><p>Djehu turns the board toward the light. “This delivery may have been counted twice. We need <strong>corroboration</strong>—someone who actually saw it.” Hori names the carrier. The guard says three people heard the accusation. “Three mouths repeating one rumor,” Djehu replies, “are still one source.”</p></details><div class="choice-heading">Your answer</div><<stoneChoice "investigate" "Hear witnesses and correct the account before assigning responsibility.">>
<<stoneChoice "punish" "Punish the accused worker to discourage future theft.">>
<<stoneChoice "conceal" "Quietly change the record so the village appears well managed.">>
<<stoneChoice "mercy" "Release the worker without investigating; compassion matters most.">></div></section></div>

:: Consequence5
<div class="novel"><aside class="scene-side"><<stoneStage 4 true>><<stoneStats>><div class="charge">The stone · 50% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>The missing measure</h1><div class="story-beats"><<stoneConsequence 4>></div><div class="after-beats"><<button "Continue" "Decision6">><</button>></div></section></div>

:: Decision6
<div class="novel"><aside class="scene-side"><<stoneStage 5>><<stoneStats>><div class="charge">The stone · 50% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>What does order require?</h1><p class="speaker">Djehu · the scribe</p><div class="story-beats"><p>Djehu stays after the others leave. ‘You keep asking what makes an order fair. We speak of ma’at: truth, justice, and the proper order of the world. But powerful people can say “order” when they mean “leave my place untouched.”’</p><p>The stone in your palm warms. A sentence appears like light beneath water: A village can be quiet because it trusts its leaders—or because it fears them.</p><p>Djehu sets his pen beside your seal. “Shall I write that your <strong>authority</strong> settles every dispute? That <strong>custom</strong> cannot be questioned? Or must an order give <strong>reasons</strong> and answer for its <strong>consequences</strong>?” He waits. “These words will remain after this evening.”</p></div><div class="after-beats"><details><summary>Ask what Djehu would write</summary><p>“I would ask who may command, what we inherited, why a decision is fair, and who must live with it.” Djehu touches the corrected account. “Truth belongs to ma’at. So does justice. A neat board is not enough if we have erased the people behind the marks.”</p></details><div class="choice-heading">Your answer</div><<stoneChoice "balance" "Use my authority to test custom, give fair reasons, and check consequences.">>
<<stoneChoice "obedience" "Authority and custom settle it: people should obey the administrator.">>
<<stoneChoice "kindness" "My generous intentions are enough; consequences cannot make the decision wrong.">></div></section></div>

:: Consequence6
<div class="novel"><aside class="scene-side"><<stoneStage 5 true>><<stoneStats>><div class="charge">The stone · 60% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>What does order require?</h1><div class="story-beats"><<stoneConsequence 5>></div><div class="after-beats"><<button "Continue" "Decision7">><</button>></div></section></div>

:: Decision7
<div class="novel"><aside class="scene-side"><<stoneStage 6>><<stoneStats>><div class="charge">The stone · 60% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>Tomorrow’s bread</h1><p class="speaker">Tia · household representative</p><div class="story-beats"><p>Tia returns with a child asleep against her shoulder. You can see now how easily the word “household” hides a person. She does not ask for a speech about the future. She asks whether there will be bread tomorrow.</p><p>There are 20 measures of seed grain set aside. Eating seed can relieve an emergency. It also means planting less. Hori says the repaired bank—if you funded it—makes protecting seed especially valuable. If the bank remains weak, seed alone is no guarantee.</p><p>Tia reaches toward the seed seal. Hori steps into the doorway. “Five measures might carry the weakest through,” she says. “Fifteen would feed more.” Hori looks at you. “And leave almost nothing to plant.” Djehu murmurs, “Your <strong>duty</strong> is to both of them. The order must still be yours.”</p></div><div class="after-beats"><details><summary>Ask what Tia would count as a promise</summary><p>“Do not promise that no one will ever be hungry. Tell us what remains, who receives it, and when you will reconsider.” Tia adjusts the sleeping child. “And when we come back, let us come with <strong>dignity</strong>. We should not have to kneel to be heard.”</p></details><div class="choice-heading">Your answer</div><<stoneChoice "preserve" "Protect all seed and explain the remaining food ration.">>
<<stoneChoice "ration" "Release five seed measures for urgent needs; protect the other fifteen.">>
<<stoneChoice "consume" "Release fifteen seed measures to relieve more hunger now.">></div></section></div>

:: Consequence7
<div class="novel"><aside class="scene-side"><<stoneStage 6 true>><<stoneStats>><div class="charge">The stone · 70% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>Tomorrow’s bread</h1><div class="story-beats"><<stoneConsequence 6>></div><div class="after-beats"><<button "Continue" "Decision8">><</button>></div></section></div>

:: Decision8
<div class="novel"><aside class="scene-side"><<stoneStage 7>><<stoneStats>><div class="charge">The stone · 70% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>The administrator is a person too</h1><p class="speaker">Hori · irrigation worker</p><div class="story-beats"><p>You wake before dawn with a headache. Every dispute now arrives at your door. A leaking jar. A missing tool. A cousin who wants a larger share. You remember a different life, school corridors, the bus, a person you hope survived.</p><p>Hori finds you asleep over the accounts. ‘If you must approve every repair, the canal will wait whenever you close your eyes.’ Djehu proposes a small team with clear responsibilities and an open record. Intef offers to take all the decisions off your hands.</p><p>Rest can look selfish when others are struggling. But exhaustion can also turn your generosity into a system nobody else can operate.</p></div><div class="after-beats"><details><summary>Ask Hori about sharing responsibility</summary><p>‘Give us authority to fix small problems and a rule for reporting what we use. Let Tia check who receives food. Let Djehu keep the account. Then someone can catch my mistakes as well as yours.’ Trust needs both room to act and ways to answer for actions.</p></details><div class="choice-heading">Your answer</div><<stoneChoice "delegate" "Share defined responsibilities and rest, while keeping decisions open to review.">>
<<stoneChoice "alone" "Keep every decision yourself and work through the night.">>
<<stoneChoice "elite" "Hand control to Intef; he has experience and resources.">></div></section></div>

:: Consequence8
<div class="novel"><aside class="scene-side"><<stoneStage 7 true>><<stoneStats>><div class="charge">The stone · 80% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>The administrator is a person too</h1><div class="story-beats"><<stoneConsequence 7>></div><div class="after-beats"><<button "Continue" "Decision9">><</button>></div></section></div>

:: Decision9
<div class="novel"><aside class="scene-side"><<stoneStage 8>><<stoneStats>><div class="charge">The stone · 80% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>Whose name remains?</h1><p class="speaker">Intef · landholder</p><div class="story-beats"><p>Intef points to the granary wall. ‘You could put your name there. People remember a name longer than a ration.’ You feel the attraction. In this borrowed life, perhaps you could leave proof you mattered.</p><p>Tia wants the account displayed: what came in, what went out, and who can challenge it. Hori wants the workers named. Djehu says there is room for a record of contributions, but a grand monument will cost eight measures of grain.</p><p>Intef traces the space where your name could go. Tia places the account beneath his hand. “Let them remember it,” she says. “But let them ask what you did. That is <strong>accountability</strong>.” The stonecutter waits outside. Eight measures would buy a beautiful inscription.</p></div><div class="after-beats"><details><summary>Remember your agreement with Intef</summary><p>Djehu unrolls the earlier record. “If we promised Intef credit, we owe him truthful credit. Not control. Not silence about the costs.” Intef listens from the doorway. “And not a smaller contribution because you dislike me,” he says.</p></details><div class="choice-heading">Your answer</div><<stoneChoice "publish" "Display the accounts, promises, and all actual contributions—including yours.">>
<<stoneChoice "monument" "Spend eight grain on a monument celebrating your leadership.">>
<<stoneChoice "credit" "Honor the workers and contributors, with a modest record of your own role.">></div></section></div>

:: Consequence9
<div class="novel"><aside class="scene-side"><<stoneStage 8 true>><<stoneStats>><div class="charge">The stone · 90% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>Whose name remains?</h1><div class="story-beats"><<stoneConsequence 8>></div><div class="after-beats"><<button "Continue" "Decision10">><</button>></div></section></div>

:: Decision10
<div class="novel"><aside class="scene-side"><<stoneStage 9>><<stoneStats>><div class="charge">The stone · 90% charged</div></aside><section class="dialogue"><div class="eyebrow">The Grain We Keep</div><h1>A village beyond you</h1><p class="speaker">Tia · household representative</p><div class="story-beats"><p>The pale line inside your stone is now a complete circle. You know, without being told, that this life is nearly finished. The village does not know. For them, tomorrow is not an epilogue.</p><p>Tia lays a hand on the granary door. ‘A good administrator can die. A bad one can inherit the seal. What have we got then?’</p><p>You can leave a council that includes households and workers, or train a successor with public records and a way to appeal decisions. Either can fail; either gives the village something beyond your intentions. You could instead trust your reputation, or spend one final generous ration and let tomorrow’s leader worry about tomorrow.</p></div><div class="after-beats"><details><summary>Ask who can safely disagree</summary><p>Tia answers immediately: ‘The person with the least to lose can always speak. I want the person with the most to lose to be able to speak too.’ A council needs more than seats. A successor needs more than your confidence. The agreement must name how complaints are heard and how decisions can be corrected.</p></details><div class="choice-heading">Your answer</div><<stoneChoice "council" "Leave a representative council, public accounts, and a protected route for complaints.">>
<<stoneChoice "successor" "Train a successor and establish public reviews and appeals.">>
<<stoneChoice "secrecy" "Leave the seal to a loyal ally and keep the accounts private.">>
<<stoneChoice "empty" "Give a final generous ration; leave the next crisis to the next leader (12 grain).">></div></section></div>

:: Consequence10
<div class="novel"><aside class="scene-side"><<stoneStage 9 true>><<stoneStats>><div class="charge">The stone · 100% charged</div></aside><section class="dialogue"><div class="eyebrow">The village answers</div><h1>What remains</h1><div class="story-beats"><<stoneConsequence 9>></div><div class="after-beats"><<button "Listen to the stone" "Assessment">><</button>></div></section></div>

:: Assessment
<div class="eyebrow">The Teaching Stone · Fully charged</div><h1>What your choices leave behind</h1><<stoneAssessment>><<if window.parent !== window>><p>Choose one decision—or a class reading—and examine your reasons. Your reflection is separate from your score.</p><<button "Reflect on a choice · Principles Portfolio">><<run setup.send("reflect")>><</button>><</if>><p>“You are more than one attempt,” the stone says. “Carry what you have learned. Or return, and see what you could do differently.”</p><<button "Press the stone: a new life awaits." "NextLife">><<run setup.send("next")>><</button>><<button "Press the stone with a wish to try again.">><<if window.parent === window>><<run setup.choices=[]; setup.refresh()>><<else>><<run setup.send("replay")>><</if>><</button>><details><summary>History, fiction and sources</summary><p>This fictional estate village is set in Middle Kingdom Egypt, approximately 1900 BCE. Its choices simplify historical institutions for ethical discussion. The magical stone, characters, dialogue, numbers and outcomes are invented. Ma’at is not identical to our modern scoring rubric. The four lenses and highlighted terms connect to your class reading, “Who gets to decide what is right?”, with selected ideas from the Week 2 lessons.</p><p><a target="_blank" rel="noopener" href="https://ethics-before-us-october.zumboggo.chatgpt.site/">Ethics Before Us · class readings</a></p><p><a target="_blank" rel="noopener" href="https://resources.metmuseum.org/resources/metpublications/pdf/The_Art_of_Ancient_Egypt_A_Resource_for_Educators.pdf">The Metropolitan Museum of Art: educator resource</a> · <a target="_blank" rel="noopener" href="https://www.britishmuseum.org/collection/object/Y_EA48998">British Museum: ma’at</a></p></details>

:: NextLife
<div class="eyebrow">A pause between lives</div><h1>The next destination is still forming.</h1><p>The stone holds the memory of this life. Your next episode will appear here when it is ready.</p><p>For now, you can return to the assessment or try this life again.</p><<button "Return to the assessment" "Assessment">><</button>>
