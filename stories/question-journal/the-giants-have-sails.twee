:: StoryTitle
The Giants Have Sails

:: StoryData
{"ifid":"9F99B57A-04B1-4DF1-85A8-F7E3C8B3B7D2","format":"SugarCube","format-version":"2.37.3","start":"Start"}

:: StoryScript [script]
// Published journal v1 rules. Scores depend only on explicit evidence checkpoints.
const notebookDomains=['Evidence','Interpretation','Language & Form','Connections'];
function journalContent(story){
 const assessYoung=(choices=[])=>{
  if(!Array.isArray(choices)||choices.length>story.scenes.length)throw new Error('Invalid journal route');
  const scores=[0,0,0,0];choices.forEach((id,i)=>{const c=story.scenes[i].choices.find(c=>c.id===id);if(!c)throw new Error('Invalid journal choice');c.points.forEach((p,j)=>scores[j]+=p);});
  const complete=choices.length===story.scenes.length;
  return {complete,scores,total:scores.reduce((a,b)=>a+b,0),indicators:scores,ending:complete?{title:'What I discovered; what I still wonder',paragraphs:[story.scenes.at(-1).choices.find(c=>c.id===choices.at(-1)).response,'My account can be accurate even when the knight disagrees. The journal keeps evidence, inference, and unanswered questions together.']}:null};
 };
 const assessDriver=(attempts=[])=>{
  if(!Array.isArray(attempts)||attempts.length>200)throw new Error('Invalid completion checks');
  let score=0,passed=false;for(const answers of attempts){if(passed)throw new Error('The return check is already complete');if(!Array.isArray(answers)||answers.length!==4||answers.some((a,i)=>!Number.isInteger(a)||a<0||a>=story.driverQuestions[i].options.length))throw new Error('Answer all four journal questions');score=answers.filter((a,i)=>a===story.driverQuestions[i].answer).length;passed=score>=3;}
  return {passed,score};
 };
 return {...story,scenes:story.scenes,sourceNotes:story.sources,assignmentPrompt:'Record what you discovered and what remains uncertain.',rubric:notebookDomains.map(n=>n+': 25 points from its explicit checkpoint; 25 supported reasoning, 5 unsupported overclaim, 0 not yet demonstrated.'),assessYoung,assessDriver};
}
function validateJournal(journal={},choices=[],sceneCount){
 if(!journal||typeof journal!=='object'||Array.isArray(journal)||Object.keys(journal).some(k=>!['question','reflection'].includes(k)))throw new Error('Invalid journal writing');
 for(const key of ['question','reflection'])if(journal[key]!==undefined&&(typeof journal[key]!=='string'||journal[key].length>1000))throw new Error('Keep each journal entry within 1000 characters');
 if(journal.question!==undefined&&!choices.length||journal.reflection!==undefined&&choices.length!==sceneCount)throw new Error('Journal entry outside its passage');
 return {...journal};
}
function journalProgress(a,sceneCount){
 const j=validateJournal(a.journal,a.choices,sceneCount);
 return [...a.choices.map((id,i)=>JSON.stringify({id,...(i===0?{question:j.question||''}:{}),...(i===sceneCount-1?{reflection:j.reflection||''}:{})})),...(a.driverAttempts||[]).map(v=>JSON.stringify(v))];
}

setup.story={"id":"the-giants-have-sails","version":1,"title":"The Giants Have Sails","chapter":"I.8","boundary":"Part I, chapter 8: first sight of the windmills through Sancho helping Quixote remount and their departure toward Puerto Lapice. Stop before the friars and Biscayan encounter. Context from I.7 is paraphrased: Sancho has joined as squire, hoping for a promised island.","concepts":["irony","juxtaposition","counterevidence","perspective"],"sources":[{"id":"sight","title":"Two accounts of the same landscape","quote":"what we see there are not giants but windmills, and what seem to be their arms are the sails that turned by the wind make the millstone go.","note":"Sancho’s words offer a mechanism for what they see. The narrator has introduced thirty or forty windmills, while Quixote calls them giants. Perspective means a position or outlook that shapes interpretation; perspectives can differ without being equally supported.","url":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch8"},{"id":"fall","title":"What happens at the mill","quote":"the wind whirled it round with such force that it shivered the lance to pieces, sweeping with it horse and rider, who went rolling over on the plain, in a sorry condition.","note":"Quixote charges despite Sancho’s warning. The narrator describes wind, sail, broken lance, and the fall. Students’ invented conversations do not prevent or replace this canonical event. Juxtaposition places things side by side; here heroic anticipation beside a mechanical collision exposes a gap.","url":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch8"},{"id":"friston","title":"An explanation after the fall","quote":"that same sage Friston who carried off my study and books, has turned these giants into mills in order to rob me of the glory of vanquishing them","note":"Quixote claims an enchanter transformed the giants. He refers to an earlier explanation about his missing library; this episode does not reconstruct that intervening plot. The claim is his explanation, not an event the narrator confirms. Counterevidence is relevant evidence that challenges a claim or explanation.","url":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch8"}],"scenes":[{"title":"Another line, another door","speaker":"journal","cast":[],"text":["Mr. Hepting sets an old journal on the desk. Its leather cover looks as if it has survived rain, travel, and a serious disagreement with a suitcase zipper.","‘I found this in an airport gift shop in Peru,’ he says. ‘Between the marmalade and the neck pillows. I asked it why boarding groups exist. I was gone three days.’ On the cover, someone has drawn a door. The little brass handle feels surprisingly real.","‘A new question on a new line,’ he says. ‘Then touch the door. It takes you somewhere you can investigate. Answers are your responsibility. So is coming back.’ I write a question. The page smells faintly of oranges. No classmates follow me: this small door is an invitation for one.","Today the page opens onto a road, not a courtyard. If this is my first visit, the journal supplies the essentials: Don Quixote has fashioned himself after knights from romances. Sancho Panza is his squire, a companion and assistant, hoping for a promised island to govern. I need no earlier episode or score to enter this page."],"choices":[{"id":"trust","label":"How can I tell which account to trust?","response":"My question settles into the paper. A dry breeze turns the corner of the page. Somewhere beyond the door, somebody is using the word “giant” with alarming confidence.","points":[0,0,0,0]},{"id":"challenge","label":"What happens when evidence challenges a story we love?","response":"I write my question and touch the drawn handle. The ink becomes a road. The journal has found an answerable problem; it has not promised an agreeable answer.","points":[0,0,0,0]},{"id":"record","label":"How do I record a disagreement fairly?","response":"I write about fair records. Two lines run down the new page: “what happened” and “what people said.” For now they are empty. Keeping them separate already feels useful.","points":[0,0,0,0]}],"kind":"question","source":null,"margin":null},{"title":"A chronicler on the plain","speaker":"sancho","cast":["sancho"],"text":["I step onto a dusty road in La Mancha. Sancho Panza turns on his donkey and introduces himself. Ahead, Don Quixote sits upright on Rocinante as if posture alone could put the whole countryside in order.","Quixote appoints me chronicler for the journey: a witness who will put the day into words. ‘I hope you brought enough paper,’ Sancho says. ‘His adventures can become larger in the telling.’ My task is to record a disagreement without pretending I can command either man.","White towers stand across the plain, with long wooden sails. Quixote announces giants. Sancho says windmills. The journal lays the two accounts side by side. I can already see a problem: a description can fit an expectation so neatly that the expectation starts looking like evidence."],"choices":[{"id":"ask-sancho","label":"I ask Sancho why he came on this journey.","response":"He mentions the island he hopes to govern, then pats his food bag. ‘A man can want an island and still recognize a mill.’ Practical observation and aspiration can live in one person. I resist making him a simple opposite of Quixote.","points":[0,0,0,0]},{"id":"ask-knight","label":"I ask what Quixote sees.","response":"‘An opportunity to serve,’ he says. ‘And arms of unusual length.’ His wish to do something meaningful is clear. Whether those shapes are arms is a separate question. My sympathy does not make the shapes into bodies.","points":[0,0,0,0]}],"kind":"question","source":null,"margin":{"text":"Cervantes leans around the page’s lower corner. “Two witnesses are useful. Two witness statements are not automatically two equally good explanations. What would let you compare them?”","followups":[{"q":"Can perspective change physical facts?","a":"“It changes what someone notices and how someone interprets it. Then ask what the text actually reports. Fairness to a voice need not mean surrendering your judgment of its evidence.”"}]}},{"title":"Arms, sails, and a working explanation","speaker":"sancho","cast":["sancho"],"text":["Sancho points to the sails. He describes wind turning them so that a millstone can grind grain. His explanation connects the visible motion to the object’s function. Quixote describes long arms and prepares for battle.","The source does not leave us with an undecidable landscape: the narrator calls the objects windmills. Still, I need to do more than say Sancho is the sensible character. An evidence entry should specify what supports his account, and avoid inventing observations I have not made.","The sails begin to move. My notebook wants a distinction between observation and interpretation before the road becomes considerably less peaceful."],"choices":[{"id":"sight-mechanism","label":"The narrator identifies windmills; Sancho explains their wind-driven sails. Quixote interprets those sails as arms.","response":"I preserve the difference between the described object and the knight’s interpretation. The explanation of a mechanism is relevant support, not just a confident label.","points":[25,0,0,0]},{"id":"sight-source","label":"I cite the narrator’s windmills and Sancho’s account, then record Quixote’s giant claim as a conflicting interpretation.","response":"Both statements remain visible. Their evidential standing does not become equal merely because both are recorded. I identify who says each thing and what supports it.","points":[25,0,0,0]},{"id":"sight-equal","label":"Because two people disagree, giants and windmills must be equally likely.","response":"Disagreement alone does not balance the evidence. I return to the narrator’s description and Sancho’s mechanism, rather than counting opinions.","points":[5,0,0,0]}],"kind":"checkpoint","source":"sight","margin":null},{"title":"A warning that might not work","speaker":"quixote","cast":["quixote"],"text":["Quixote adjusts his lance. I have one chance to speak before he moves. My appointment gives me a voice, not authority over his decisions.","A specific observation could challenge him directly. A question could invite him to test his own account. Either can be sound; either can fail to persuade. Mockery might make me feel certain while making him less willing to listen. The learning credit is in my evidence entries, not whether he approves of my intervention.","I stay beside Sancho, clear of the moving sails. Which approach will I try?"],"choices":[{"id":"warn-observe","label":"I point to the wind-driven sails and ask him to pause before charging.","response":"‘You see machinery where I see injustice,’ he says. My warning is specific and unsuccessful. Sancho calls after him too. Neither of us gets to control what he does next.","points":[0,0,0,0]},{"id":"warn-test","label":"I ask what observation would persuade him that these are mills.","response":"For a moment he looks back. ‘A useful question after the victory.’ He postpones the test and spurs Rocinante. The question opens a crack in the conversation, then confidence closes it.","points":[0,0,0,0]},{"id":"warn-mock","label":"I laugh at him and tell him nobody sensible sees giants.","response":"His shoulders stiffen. ‘Then courage has become unfashionable.’ I have challenged his identity without showing the evidence. Sancho still warns him about the mills. My laughter has not protected anyone.","points":[0,0,0,0]}],"kind":"commitment","source":null,"margin":null},{"title":"The world answers in wood","speaker":"quixote","cast":["quixote"],"text":["Rocinante carries him toward the first mill. A breeze turns the sails. Quixote charges; his lance strikes a sail, breaks, and horse and rider tumble onto the plain. I remain safely with Sancho. No choice of mine rewrites this event.","For an instant there is no grand speech. There is a broken lance and a man who needs help. Sancho goes to him and helps him rise. I hold my journal shut against the dust. The comedy has not removed the pain.","Juxtaposition puts things beside each other so that their relationship becomes noticeable. Irony involves a gap between a claim or expectation and what the text lets us understand. Here heroic anticipation meets the ordinary workings of a mill. What does that arrangement do?"],"choices":[{"id":"form-gap","label":"The heroic expectation is set beside a mechanical collision; the gap makes the confidence ironic and the harm visible.","response":"I explain how the juxtaposition creates an ironic gap, while keeping the physical consequences in view. The scene can be funny and troubling at the same time.","points":[0,0,25,0]},{"id":"form-reader","label":"The narrator and Sancho identify mills before the charge, so the reader anticipates a collision that Quixote interprets as combat.","response":"I connect the order of information to the reader’s understanding. The irony comes from what we know beside what he believes; “something funny happens” would not explain the form.","points":[0,0,25,0]},{"id":"form-insult","label":"Irony simply means that Quixote is stupid and Sancho is always right.","response":"That replaces an explanation of the text with two labels. I should identify the claim, the evidence, and the gap in this scene. Nothing here proves that Sancho is infallible in every situation.","points":[0,0,5,0]}],"kind":"checkpoint","source":"fall","margin":{"text":"Cervantes sets his quill down. “You may laugh before the fall. Now a hand reaches toward him. What does that change about the kind of laughter this scene allows?”","followups":[{"q":"Does sympathy cancel criticism?","a":"“Try holding the broken lance and the wish to help in the same account. Sympathy can ask why a belief matters; criticism can ask whether it fits the evidence. Neither needs to erase the other.”"}]}},{"title":"The explanation that survives everything","speaker":"quixote","cast":["quixote"],"text":["Quixote says the enchanter Friston has turned the giants into mills to rob him of glory. He refers to an earlier account of his vanished library. The narrator reports his explanation without confirming that a transformation happened.","Sancho’s mouth tightens. He has already identified windmills before the charge. The knight can make that inconvenient detail disappear by adding more magic, but I need to ask what could then count against the explanation.","Counterevidence is relevant evidence that challenges a claim. If every possible result becomes proof of the same claim, an explanation stops being open to correction. My journal will not write “false because I dislike it.” It asks for a reason."],"choices":[{"id":"counter-before","label":"Sancho identifies mills before the charge; a transformation after defeat does not account for that earlier observation.","response":"The timing matters. I identify counterevidence rather than relying on ridicule. Quixote could add an earlier enchantment, but that would be a new claim needing support.","points":[0,25,0,0]},{"id":"counter-test","label":"The narrator supplies mills and mechanical causes, while the transformation lacks confirmation; I ask what evidence could challenge it.","response":"I weigh support and name a test of openness to revision. I cannot prove every imaginable magic impossible; I can show why this explanation is less supported by this passage.","points":[0,25,0,0]},{"id":"counter-magic","label":"Because magic explains any outcome, the transformation must be true.","response":"An explanation’s flexibility is not evidence that it happened. I need support for the transformation and attention to the mills identified before the charge.","points":[0,5,0,0]}],"kind":"checkpoint","source":"friston","margin":null},{"title":"From a road to an argument","speaker":"sancho","cast":["sancho"],"text":["Sancho helps Quixote remount. He does not withdraw his description of the mills. Being right has not made his companion unhurt, and assistance does not require him to adopt the giant story.","I think about a claim outside this journey: a rumor, a heroic narrative, an advertisement, or my own first interpretation of a text. When a result goes badly, it is tempting to protect the original story with an explanation that nothing could challenge.","A useful connection will transfer a method, not declare that modern people and a Spanish literary character are identical. What should I carry back from this disagreement?"],"choices":[{"id":"transfer-test","label":"For another claim, separate observations from explanations and ask what would count against it; then check relevant evidence.","response":"The method transfers while the contexts remain different. I could use it on an advertisement or another literary interpretation without treating either as the same story.","points":[0,0,0,25]},{"id":"transfer-compare","label":"Compare this with a specific hero’s response to a setback: what evidence is available, and does the hero revise or protect the original belief?","response":"The question invites a passage-based comparison. It does not assume that every hero responds in the same way. I leave a space for the other text and its different circumstances.","points":[0,0,0,25]},{"id":"transfer-everyone","label":"Anyone with a hopeful dream is just another Don Quixote, so dreams should be abandoned.","response":"The analogy erases the difference between aspiration and disregard for evidence. This encounter challenges a particular belief and its defense, not every possible hope.","points":[0,0,0,5]}],"kind":"checkpoint","source":null,"margin":{"text":"Cervantes lets a few grains of dust fall off the margin. “A comparison is a bridge, not a machine for making everything identical. Which difference would your bridge need to leave visible?”","followups":[{"q":"Is there one correct theme?","a":"“There can be several defensible accounts of hope, self-invention, and resistance to evidence. Show which details support yours and what it leaves unexplained. My approving expression is not a quotation from the novel.”"}]}},{"title":"What the witness leaves on the page","speaker":"quixote","cast":["quixote"],"text":["The road continues toward Puerto Lapice. Quixote still expects adventures. Sancho still has practical concerns. The sails turn behind us, grinding grain with no apparent interest in reputation.","I cannot claim that my argument changed the knight. I can decide how to record a conversation that failed. The account must make his hope intelligible without giving his explanation evidence it does not have.","My journal reopens to the question that brought me here. I may write what I discovered and what remains uncertain. I have witnessed a canonical event; I have also learned that a strong reason and a successful persuasion are different things."],"choices":[{"id":"record-separate","label":"I record the mills and fall as events, and his enchantment story as a claim, adding why the earlier evidence challenges it.","response":"Quixote dislikes the word “claim.” I leave it there, with his reasons beside it. Sancho asks me to include that he helped. I do: his assistance shows care without surrendering judgment.","points":[0,0,0,0]},{"id":"record-voices","label":"I preserve both voices, then explain why the narrator’s details and Sancho’s mechanism support the mill account.","response":"Neither voice disappears. I make the difference in evidential support clear. Quixote requests a more heroic title. I can offer a respectful title without changing the facts underneath it.","points":[0,0,0,0]},{"id":"record-flatter","label":"I call the defeated giants a victory and omit the mill evidence.","response":"He approves. My evidence notebook does not. The journal keeps my chosen account beside the details I recorded, so I can see where I protected approval at the expense of an explanation. The episode ends with that revision still available to me.","points":[0,0,0,0]}],"kind":"commitment","source":null,"margin":null}],"driverQuestions":[{"prompt":"What supports the windmill account?","options":["Sancho sounds confident, so no evidence is needed.","The narrator identifies mills; Sancho explains the wind-driven sails.","Two accounts must be equally supported."],"answer":1,"note":"Compare specific evidence and mechanisms, not confidence or the number of opinions."},{"prompt":"What produces irony in the charge?","options":["The reader knows the objects are mills while Quixote acts as if they are giants.","All comedy is irony.","The narrator confirms a real transformation."],"answer":0,"note":"The gap between the reader’s supported understanding and the knight’s belief shapes the scene."},{"prompt":"Which detail challenges a transformation after the defeat?","options":["Quixote wants glory.","Sancho travels on a donkey.","Sancho identifies windmills before the charge."],"answer":2,"note":"Earlier mill identification is counterevidence to an explanation that places transformation after defeat."},{"prompt":"What can a fair account do?","options":["Remove Quixote’s voice because he is wrong.","Preserve both voices and explain why their claims have different support.","Treat sympathy as proof of giants."],"answer":1,"note":"Fair representation and evidence-based judgment can coexist; failed persuasion does not invalidate strong reasoning."}],"sourceUrl":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch8","edition":"Miguel de Cervantes, Don Quixote, translated by John Ormsby (1885), Project Gutenberg eBook 996, public domain.","checked":"2026-10-10","notes":"Original dialogue, student appointment, journal magic, and Cervantes margin visits are authored fiction. Labelled source cards alone contain authentic excerpts. Author, narrator, and character voices are distinct. These are episode concepts; a current assigned weekly vocabulary list and class translation were not verified. Read the assigned class text as well. No live AI responses."};const content=journalContent(setup.story);setup.scenes=content.scenes;setup.assess=content.assessYoung;setup.assessDriver=content.assessDriver;setup.driverQuestions=content.driverQuestions;setup.sources=content.sourceNotes;setup.characters={quixote:"Don Quixote",sancho:"Sancho Panza",niece:"Quixote’s niece",journal:"My journal"};
Config.history.maxStates=1;Config.history.controls=false;Config.saves.isAllowed=()=>false;Config.ui.stowBarInitially=true;Config.passages.nobr=true;
setup.attemptId=parent===window?crypto.randomUUID():'standalone';setup.choices=[];setup.driverAttempts=[];setup.journal={};setup.drafts={};setup.channel=null;setup.ready=false;setup.booted=false;setup.accepted=false;
Config.navigation.override=destination=>setup.ready?destination:'Start';
setup.send=(type,extra={})=>{if(parent!==window&&setup.channel)parent.postMessage({protocol:'episode-v1',episode:setup.story.id,version:setup.story.version,channel:setup.channel,type,choices:setup.choices.slice(),driverAttempts:setup.driverAttempts.map(v=>v.slice()),journal:{...setup.journal},...extra},location.origin);};
setup.refresh=()=>Engine.play(!setup.accepted?'Start':setup.choices.length===setup.scenes.length?(setup.assessDriver(setup.driverAttempts).passed?'Assessment':'Driver'):setup.choices.length?'Consequence'+setup.choices.length:'Decision1');
window.addEventListener('message',event=>{const m=event.data;if(event.origin!==location.origin||event.source!==parent||m?.protocol!=='episode-v1'||m.type!=='init'||m.episode!==setup.story.id||m.version!==setup.story.version||typeof m.channel!=='string')return;if(setup.ready){if(setup.booted){if(State.passage==='Start')setup.refresh();setup.send('started');}return;}try{setup.assess(m.choices);setup.assessDriver(m.driverAttempts||[]);validateJournal(m.journal,m.choices,setup.scenes.length);}catch{return;}setup.attemptId=typeof m.attemptId==='string'?m.attemptId:'standalone';setup.channel=m.channel;setup.choices=m.choices.slice();setup.journal={...m.journal};setup.drafts={...m.journalDraft};setup.accepted=setup.choices.length>0;setup.driverAttempts=(m.driverAttempts||[]).map(v=>v.slice());setup.ready=true;if(setup.booted){setup.refresh();setup.send('started');}});
const paragraph=(target,text)=>{const p=document.createElement('p');p.textContent=text;target.append(p);return p;};
const asset=n=>'../../question-journal/v1/'+n;
Macro.add('ownChoice',{handler(){const [id,label]=this.args,step=setup.choices.length,b=document.createElement('button');b.className='stone-choice';b.textContent=label;b.onclick=()=>{if(b.disabled||setup.choices.length!==step)return;b.disabled=true;const input=document.getElementById('journal-entry');if(input){if(step===0)setup.journal.question=input.value;else if(step===setup.scenes.length-1)setup.journal.reflection=input.value;}setup.choices.push(id);setup.send('save');Engine.play('Consequence'+(step+1));};this.output.append(b);}});
Macro.add('ownPersonal',{handler(){const key=this.args[0],label=document.createElement('label'),input=document.createElement('textarea');input.id='journal-entry';input.rows=3;input.maxLength=1000;label.htmlFor=input.id;label.textContent=key==='question'?'My own question (optional)':'What I discovered; what remains uncertain (optional)';input.value=setup.drafts[key]||setup.journal[key]||'';input.oninput=()=>{setup.drafts[key]=input.value;setup.send('draft',{field:key,text:input.value});};this.output.append(label,input);paragraph(this.output,'This private line is saved when I choose below. It earns no correctness points and does not generate a bespoke answer.');}});
Macro.add('ownConsequence',{handler(){const i=Number(this.args[0]),c=setup.scenes[i].choices.find(c=>c.id===setup.choices[i]);paragraph(this.output,c.response);if(i===0&&setup.journal.question)paragraph(this.output,'My personal question: '+setup.journal.question);}});
Macro.add('ownSource',{handler(){const ids=this.args.length?this.args:setup.sources.map(s=>s.id);for(const id of ids){const s=setup.sources.find(s=>s.id===id);if(!s)continue;const d=document.createElement('details');d.open=true;const title=document.createElement('summary');title.textContent='Source card · '+s.title;d.append(title);const q=document.createElement('blockquote');q.textContent=s.quote;d.append(q);paragraph(d,'Exact excerpt · Don Quixote '+setup.story.chapter+' · John Ormsby translation (1885)');paragraph(d,s.note);const a=document.createElement('a');a.href=s.url;a.target='_blank';a.rel='noopener';a.textContent='Read the full source chapter';d.append(a);this.output.append(d);}}});
Macro.add('ownStats',{handler(){const s=setup.assess(setup.choices),box=document.createElement('div');box.className='stone-stats';notebookDomains.forEach((name,i)=>{const cell=document.createElement('div'),label=document.createElement('span'),n=document.createElement('strong');label.textContent=name;n.textContent=s.scores[i]+'/25';cell.append(label,n);box.append(cell);});this.output.append(box);const d=document.createElement('details');d.innerHTML='<summary>My notebook rubric</summary><p>Four explicit checkpoints, each worth 25. Supported observation and reasoning earn 25; an unsupported overclaim earns 5; not yet demonstrated earns 0. Two distinct supported answers are available at every checkpoint. Question selection, character approval, and persuasion earn no correctness points. This private episode score is not a posted course grade.</p>';this.output.append(d);}});
Macro.add('ownStage',{handler(){const i=Number(this.args[0]),s=setup.scenes[i],stage=document.createElement('div');stage.className='stage';stage.style.backgroundImage='url("'+asset('landscape.webp')+'")';stage.setAttribute('role','group');stage.setAttribute('aria-label','La Mancha: courtyard, road, and distant windmills');if(s.speaker==='journal'){const door=document.createElement('div');door.className='journal-door';door.textContent='The Question Journal';const mark=document.createElement('span');mark.textContent='♧';door.append(mark);stage.append(door);}else{const figure=document.createElement('figure'),sprite=document.createElement('div'),caption=document.createElement('figcaption');figure.className='character speaking';sprite.className='sprite';sprite.style.backgroundImage='url("'+asset(s.speaker+'.webp')+'")';const mood=setup.story.id==='the-giants-have-sails'&&i>=4?'troubled':'neutral';sprite.style.backgroundPosition=mood==='troubled'?'100% 0':'0% 0';sprite.setAttribute('role','img');sprite.setAttribute('aria-label',setup.characters[s.speaker]+' · '+mood);caption.textContent=setup.characters[s.speaker]+' · '+mood;figure.append(sprite,caption);stage.append(figure);}this.output.append(stage);}});
Macro.add('ownMargin',{handler(){const margin=setup.scenes[Number(this.args[0])].margin;if(!margin)return;const inset=document.createElement('aside');inset.className='cervantes-margin';inset.setAttribute('aria-label','Cervantes at the edge of the page');const img=document.createElement('div');img.className='margin-portrait';img.style.backgroundImage='url("'+asset('cervantes.webp')+'")';img.setAttribute('role','img');img.setAttribute('aria-label','Cervantes peeking into the margin');inset.append(img);paragraph(inset,margin.text);margin.followups.forEach(f=>{const d=document.createElement('details'),sum=document.createElement('summary');sum.textContent=f.q;d.append(sum);paragraph(d,f.a);inset.append(d);});this.output.append(inset);}});
Macro.add('ownExplore',{handler(){const scene=setup.scenes[Number(this.args[0])];if(scene.kind!=='question')return;const heading=document.createElement('h2');heading.textContent='Keep asking, or continue';this.output.append(heading);scene.choices.filter(c=>c.id!==setup.choices[Number(this.args[0])]).forEach(c=>{const d=document.createElement('details'),summary=document.createElement('summary');summary.textContent=c.label;d.append(summary);paragraph(d,c.response);this.output.append(d);});}});
Macro.add('ownDriver',{handler(){const root=this.output,heading=document.createElement('h1');heading.textContent='The journal’s return page';root.append(heading);paragraph(root,'The door appears again on the cover. The journal asks four questions. Three correct open it. If I miss the threshold, I review and try again; my choices and personal writing remain safe.');const previous=setup.assessDriver(setup.driverAttempts);if(setup.driverAttempts.length){paragraph(root,'Last check: '+previous.score+'/4. My notebook and route are preserved.');const answers=setup.driverAttempts.at(-1);setup.driverQuestions.forEach((q,i)=>{if(answers[i]!==q.answer)paragraph(root,'Review '+(i+1)+': '+q.note);});}const form=document.createElement('form');root.append(form);setup.driverQuestions.forEach((q,i)=>{const group=document.createElement('fieldset'),legend=document.createElement('legend');legend.textContent=(i+1)+'. '+q.prompt;group.append(legend);q.options.forEach((text,n)=>{const label=document.createElement('label'),input=document.createElement('input');input.type='radio';input.name='fare-'+i;input.value=n;input.required=true;label.append(input,document.createTextNode(' '+text));group.append(label);});form.append(group);});const button=document.createElement('button');button.type='submit';button.textContent='Open the return door';form.append(button);form.onsubmit=event=>{event.preventDefault();if(!form.reportValidity())return;button.disabled=true;setup.driverAttempts.push(setup.driverQuestions.map((_,i)=>Number(new FormData(form).get('fare-'+i))));setup.send('save');setup.refresh();};const review=document.createElement('details'),summary=document.createElement('summary');summary.textContent='Review the source cards';review.append(summary);new Wikifier(review,'<<ownSource>>');root.append(review);}});
Macro.add('ownAssessment',{handler(){const a=setup.assess(setup.choices);paragraph(this.output,'The journal records what I discovered and leaves a space for what remains uncertain. The return door opens. I step through alone, back into the classroom. Mr. Hepting looks up. “Find anything?” I have more than an answer now: I have a better question.');a.ending.paragraphs.forEach(p=>paragraph(this.output,p));paragraph(this.output,'My first commitment: '+setup.scenes[3].choices.find(c=>c.id===setup.choices[3]).label);paragraph(this.output,'My opening question: '+setup.scenes[0].choices.find(c=>c.id===setup.choices[0]).label);if(setup.journal.question)paragraph(this.output,'My personal question: '+setup.journal.question);if(setup.journal.reflection)paragraph(this.output,'My reflection: '+setup.journal.reflection);paragraph(this.output,a.total+'/100 · Notebook learning');notebookDomains.forEach((n,i)=>paragraph(this.output,n+': '+a.scores[i]+'/25'));const d=document.createElement('details'),sum=document.createElement('summary');sum.textContent='See the evidence behind my score';d.append(sum);setup.choices.forEach((id,i)=>{const scene=setup.scenes[i],c=scene.choices.find(c=>c.id===id);if(scene.kind!=='checkpoint')return;paragraph(d,scene.title+' — '+c.label);paragraph(d,c.response+' Points: '+c.points.join(' / '));});this.output.append(d);paragraph(this.output,'Carry into class: choose one specific detail, explain what it supports, then name something it does not establish. My next encounter starts fresh, regardless of this score or the knight’s approval.');setup.send('complete');}});
// Passage-local pacing never changes the immutable choice history or score.
setup.cancelReveal=()=>{};
$(document).on(':passageinit',()=>setup.cancelReveal());
$(document).on(':passagedisplay',function(){
 const passage=document.querySelector('.passage'),beats=passage.querySelector('.story-beats'),after=passage.querySelector('.after-beats');
 if(beats&&after){
  const paragraphs=Array.from(beats.children);const full=document.createElement('div');full.className='sr-only';full.innerHTML=beats.innerHTML;beats.before(full);beats.setAttribute('aria-hidden','true');let index=0,timer=null,finish=()=>{};
  const controls=document.createElement('div');controls.className='beat-controls';
  const next=document.createElement('button'),all=document.createElement('button'),counter=document.createElement('span');
  next.textContent='Next ▸';all.textContent='Show all';all.className='quiet';counter.className='beat-count';
  controls.append(counter,next,all);beats.after(controls);after.hidden=true;
  const stop=()=>{if(timer)clearInterval(timer);timer=null;};setup.cancelReveal=stop;
  const show=()=>{
   stop();paragraphs.forEach((p,i)=>p.hidden=i!==index);const p=paragraphs[index];
   counter.textContent=(index+1)+' / '+paragraphs.length;next.textContent=index===paragraphs.length-1?'Continue ▸':'Next ▸';
   // Keep full accessible text; the optional visual reveal never delays screen readers.
   const original=p.innerHTML;finish=()=>{stop();p.innerHTML=original;};
   if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
    const accessible=document.createElement('span');accessible.className='sr-only';accessible.innerHTML=original;
    const visual=document.createElement('span');visual.setAttribute('aria-hidden','true');visual.innerHTML=original;
    p.replaceChildren(accessible,visual);const walker=document.createTreeWalker(visual,NodeFilter.SHOW_TEXT),nodes=[];let node;
    while((node=walker.nextNode()))nodes.push({node,text:node.textContent});nodes.forEach(n=>n.node.textContent='');
    let n=0,c=0;timer=setInterval(()=>{for(let j=0;j<3&&n<nodes.length;j++){const entry=nodes[n];entry.node.textContent=entry.text.slice(0,++c);if(c>=entry.text.length){n++;c=0;}}if(n===nodes.length)finish();},16);
   }
  };
  const unlock=(showAll=false)=>{finish();if(showAll)paragraphs.forEach(p=>p.hidden=false);else{const recall=document.createElement('details');recall.innerHTML='<summary>Recall the conversation</summary>'+paragraphs.map(p=>'<p>'+p.innerHTML+'</p>').join('');after.prepend(recall);}controls.remove();after.hidden=false;const target=after.querySelector('summary,button');target?.focus({preventScroll:true});};
  next.addEventListener('click',()=>{if(timer){finish();return;}if(index<paragraphs.length-1){index++;show();}else unlock();});
  all.addEventListener('click',()=>unlock(true));show();
 }
 const h=passage.querySelector('h1');if(h){h.setAttribute('tabindex','-1');h.focus({preventScroll:true});}window.scrollTo(0,0);
});

$(document).one(':storyready',()=>{setup.booted=true;if(setup.channel){setup.refresh();setup.send('started');}if(parent===window){setup.ready=true;setup.refresh();return;}parent.postMessage({protocol:'episode-v1',episode:setup.story.id,version:setup.story.version,type:'ready'},location.origin);});


:: StoryStylesheet [stylesheet]
:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#172c2c;color:#f7edd8;font:18px/1.65 Georgia,serif}#ui-bar{display:none}#story,#ui-bar.stowed~#story{margin:0!important}#passages{max-width:1200px;margin:auto;padding:0}.passage{padding:24px;min-height:95vh}.novel{display:grid;grid-template-columns:minmax(260px,.95fr) minmax(300px,1.05fr);gap:26px}.scene-side{position:sticky;top:18px;align-self:start}.stage{height:300px;display:flex;align-items:end;justify-content:center;background:#967c4c url('village-pixel.webp') center/cover;border:3px solid #b3975f;box-shadow:0 8px 0 #0f2024;image-rendering:pixelated;overflow:hidden}.character{width:min(50%,210px);margin:0;position:relative;filter:brightness(.9)}.character.speaking{filter:none}.sprite{width:100%;aspect-ratio:4/5;background-size:300% 100%;background-repeat:no-repeat;image-rendering:pixelated}figcaption{background:#102725e8;color:#f9e8bc;font:12px/1.5 system-ui,sans-serif;text-align:center;padding:5px 2px}.dialogue{background:#fcf3df;color:#30291f;border:3px solid #b3975f;padding:24px;box-shadow:0 8px 0 #0f2024;min-height:480px}h1,h2{line-height:1.18;letter-spacing:-.02em}h1{font-size:1.9rem;margin:12px 0}h2{font-size:1.5rem}h1:focus{outline:none}p{margin:0 0 1em}.eyebrow,.speaker,.stone-stats,button,summary,.charge,.beat-count,.choice-heading{font-family:system-ui,sans-serif}.eyebrow{font-size:.65rem;text-transform:uppercase;letter-spacing:.17em;color:#776042}.speaker{font-size:.8rem;color:#725728;font-weight:650;border-bottom:1px solid #cbb990;padding-bottom:10px}.story-beats{min-height:190px}.story-beats strong{color:#1f665c}.stone-choice,button{display:block;width:100%;margin:10px 0;padding:12px 14px;text-align:left;border:2px solid #9c8559;border-radius:3px;background:#eee2c6;color:#243f37;font-size:.94rem;line-height:1.5;cursor:pointer;min-height:48px}.stone-choice:hover,button:hover{background:#dfebcf;border-color:#577a6d}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #2391aa;outline-offset:3px}button:disabled{color:#746f62;background:#eeeae2;cursor:not-allowed;opacity:.75}.stone-stats{display:grid;gap:3px;margin:18px 0 8px}.stone-stats>div{display:flex;justify-content:space-between;gap:10px;padding:7px 12px;background:#213b39;border-left:3px solid #b3975f}.stone-stats span{font-size:.75rem;color:#cfccb7}.stone-stats strong{font-size:.8rem;font-weight:600}details{font-size:.88rem;border-bottom:1px solid #b3975f66;padding:12px 0;margin-bottom:12px}summary{cursor:pointer;color:inherit;font-weight:600}details p{margin:12px 0 0}.charge{font-size:.7rem;color:#dfc782;letter-spacing:.1em}.score{padding:16px;background:#315849;color:#fff3c7;font-size:1.3rem;border-radius:3px}a{color:#82cfc0}.dialogue a{color:#22645b}.passage li{margin:8px 0}.stone-note{padding:12px 16px;border-left:3px solid #bcb08d;background:#29423c}.beat-controls{display:flex;align-items:center;gap:8px}.beat-controls button{width:auto}.beat-controls .quiet{margin-left:auto;background:transparent;border-color:transparent;font-size:.75rem}.beat-count{font-size:.7rem;white-space:nowrap}.choice-heading{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;margin-top:20px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:680px){body{font-size:17px}.passage{padding:10px}.novel{display:block}.scene-side{position:static}.stage{height:190px}.character{width:128px}.sprite{height:160px;aspect-ratio:auto}.stone-stats{grid-template-columns:1fr 1fr;margin:12px 0 6px;gap:4px}.stone-stats>div{display:block;padding:5px 8px}.stone-stats span,.stone-stats strong{display:block;font-size:.68rem}.scene-side details{padding:5px 0;font-size:.75rem;margin-bottom:4px}.charge{margin:6px 0 12px}.dialogue{padding:18px;min-height:350px}h1{font-size:1.5rem}.story-beats{min-height:150px}.stone-choice{font-size:.9rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

#passage-assessment,#passage-nextlife,#passage-start{max-width:800px;margin:auto}#passage-assessment .eyebrow,#passage-nextlife .eyebrow,#passage-start .eyebrow{color:#dfc782}

blockquote{border-left:4px solid #b3975f;padding:8px 14px;margin:12px 0}#passage-assessment a{color:#bcefe1}.stage{background-color:#26453f}.sprite{background-size:300% 100%}

/* Cervantes occupies page space, never floats over controls. */
.cervantes-margin{margin:24px 0 18px auto;max-width:400px;border:2px dashed #9c8559;background:#eadfc7;padding:16px;color:#40342a;font-size:.88rem;min-height:130px}.margin-portrait{float:right;width:72px;height:90px;background-size:300% 100%;background-position:0 0;image-rendering:pixelated;margin:0 0 8px 12px}.cervantes-margin:after{content:"";display:block;clear:both}.cervantes-margin details{clear:both}.journal-door{border:3px solid #533a23;border-radius:10px 10px 0 0;background:#a58a59;color:#241e13;text-align:center;font-size:20px;padding:20px;width:160px;height:205px;box-shadow:inset 0 0 0 6px #715536}.journal-door span{display:block;font-size:40px;line-height:1.6}textarea{display:block;background:#fff8e7;border:2px solid #9c8559;color:#30291f;width:100%;font:16px/1.5 system-ui;padding:12px;margin:8px 0}fieldset{margin:18px 0;padding:14px;border:1px solid #9c8559}fieldset label{display:block;padding:10px 0;min-height:48px;cursor:pointer}fieldset input{margin-right:8px}#passage-driver{max-width:800px;margin:auto}#passage-driver a{color:#bcefe1}@media(max-width:680px){.cervantes-margin{max-width:none;width:100%;margin:16px 0}.journal-door{height:170px;width:135px;font-size:16px;padding:12px}.character{width:128px}.stage{height:190px}}


:: Start
<div class="eyebrow">World Literature · The Question Journal</div><h1>The Giants Have Sails</h1><p>12–15 minutes with optional conversations · Two consequential commitments · No timer · Independent replays</p><p>All characters are imaginative recreations of real or fictional people and may not represent their actual views or ideas. Only labelled source excerpts are authentic quotations.</p><<if setup.ready>><<button "Accept">><<run setup.accepted=true;setup.refresh()>><</button>><<else>><p>Connecting to my class…</p><</if>>

:: Decision1
<div class="novel"><aside class="scene-side"><<ownStage 0>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>Another line, another door</h1><p class="speaker">My journal</p><div class="story-beats"><p>Mr. Hepting sets an old journal on the desk. Its leather cover looks as if it has survived rain, travel, and a serious disagreement with a suitcase zipper.</p><p>‘I found this in an airport gift shop in Peru,’ he says. ‘Between the marmalade and the neck pillows. I asked it why boarding groups exist. I was gone three days.’ On the cover, someone has drawn a door. The little brass handle feels surprisingly real.</p><p>‘A new question on a new line,’ he says. ‘Then touch the door. It takes you somewhere you can investigate. Answers are your responsibility. So is coming back.’ I write a question. The page smells faintly of oranges. No classmates follow me: this small door is an invitation for one.</p><p>Today the page opens onto a road, not a courtyard. If this is my first visit, the journal supplies the essentials: Don Quixote has fashioned himself after knights from romances. Sancho Panza is his squire, a companion and assistant, hoping for a promised island to govern. I need no earlier episode or score to enter this page.</p></div><div class="after-beats"><<ownPersonal "question">><<ownChoice "trust" "How can I tell which account to trust?">>
<<ownChoice "challenge" "What happens when evidence challenges a story we love?">>
<<ownChoice "record" "How do I record a disagreement fairly?">></div></section></div>

:: Consequence1
<div class="novel"><aside class="scene-side"><<ownStage 0>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><h1>Another line, another door</h1><div class="story-beats"><<ownConsequence 0>></div><div class="after-beats"><<ownExplore 0>><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision2">><</button>></div></section></div>

:: Decision2
<div class="novel"><aside class="scene-side"><<ownStage 1>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>A chronicler on the plain</h1><p class="speaker">Sancho Panza</p><div class="story-beats"><p>I step onto a dusty road in La Mancha. Sancho Panza turns on his donkey and introduces himself. Ahead, Don Quixote sits upright on Rocinante as if posture alone could put the whole countryside in order.</p><p>Quixote appoints me chronicler for the journey: a witness who will put the day into words. ‘I hope you brought enough paper,’ Sancho says. ‘His adventures can become larger in the telling.’ My task is to record a disagreement without pretending I can command either man.</p><p>White towers stand across the plain, with long wooden sails. Quixote announces giants. Sancho says windmills. The journal lays the two accounts side by side. I can already see a problem: a description can fit an expectation so neatly that the expectation starts looking like evidence.</p></div><div class="after-beats"><<ownMargin 1>><<ownChoice "ask-sancho" "I ask Sancho why he came on this journey.">>
<<ownChoice "ask-knight" "I ask what Quixote sees.">></div></section></div>

:: Consequence2
<div class="novel"><aside class="scene-side"><<ownStage 1>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><h1>A chronicler on the plain</h1><div class="story-beats"><<ownConsequence 1>></div><div class="after-beats"><<ownExplore 1>><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision3">><</button>></div></section></div>

:: Decision3
<div class="novel"><aside class="scene-side"><<ownStage 2>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>Arms, sails, and a working explanation</h1><p class="speaker">Sancho Panza</p><div class="story-beats"><p>Sancho points to the sails. He describes wind turning them so that a millstone can grind grain. His explanation connects the visible motion to the object’s function. Quixote describes long arms and prepares for battle.</p><p>The source does not leave us with an undecidable landscape: the narrator calls the objects windmills. Still, I need to do more than say Sancho is the sensible character. An evidence entry should specify what supports his account, and avoid inventing observations I have not made.</p><p>The sails begin to move. My notebook wants a distinction between observation and interpretation before the road becomes considerably less peaceful.</p></div><div class="after-beats"><<ownSource "sight">><<ownChoice "sight-mechanism" "The narrator identifies windmills; Sancho explains their wind-driven sails. Quixote interprets those sails as arms.">>
<<ownChoice "sight-source" "I cite the narrator’s windmills and Sancho’s account, then record Quixote’s giant claim as a conflicting interpretation.">>
<<ownChoice "sight-equal" "Because two people disagree, giants and windmills must be equally likely.">></div></section></div>

:: Consequence3
<div class="novel"><aside class="scene-side"><<ownStage 2>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><h1>Arms, sails, and a working explanation</h1><div class="story-beats"><<ownConsequence 2>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision4">><</button>></div></section></div>

:: Decision4
<div class="novel"><aside class="scene-side"><<ownStage 3>><<ownStats>><p class="charge">A commitment · no correctness points</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>A warning that might not work</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>Quixote adjusts his lance. I have one chance to speak before he moves. My appointment gives me a voice, not authority over his decisions.</p><p>A specific observation could challenge him directly. A question could invite him to test his own account. Either can be sound; either can fail to persuade. Mockery might make me feel certain while making him less willing to listen. The learning credit is in my evidence entries, not whether he approves of my intervention.</p><p>I stay beside Sancho, clear of the moving sails. Which approach will I try?</p></div><div class="after-beats"><<ownChoice "warn-observe" "I point to the wind-driven sails and ask him to pause before charging.">>
<<ownChoice "warn-test" "I ask what observation would persuade him that these are mills.">>
<<ownChoice "warn-mock" "I laugh at him and tell him nobody sensible sees giants.">></div></section></div>

:: Consequence4
<div class="novel"><aside class="scene-side"><<ownStage 3>><<ownStats>><p class="charge">A commitment · no correctness points</p></aside><section class="dialogue"><h1>A warning that might not work</h1><div class="story-beats"><<ownConsequence 3>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision5">><</button>></div></section></div>

:: Decision5
<div class="novel"><aside class="scene-side"><<ownStage 4>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>The world answers in wood</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>Rocinante carries him toward the first mill. A breeze turns the sails. Quixote charges; his lance strikes a sail, breaks, and horse and rider tumble onto the plain. I remain safely with Sancho. No choice of mine rewrites this event.</p><p>For an instant there is no grand speech. There is a broken lance and a man who needs help. Sancho goes to him and helps him rise. I hold my journal shut against the dust. The comedy has not removed the pain.</p><p>Juxtaposition puts things beside each other so that their relationship becomes noticeable. Irony involves a gap between a claim or expectation and what the text lets us understand. Here heroic anticipation meets the ordinary workings of a mill. What does that arrangement do?</p></div><div class="after-beats"><<ownSource "fall">><<ownMargin 4>><<ownChoice "form-gap" "The heroic expectation is set beside a mechanical collision; the gap makes the confidence ironic and the harm visible.">>
<<ownChoice "form-reader" "The narrator and Sancho identify mills before the charge, so the reader anticipates a collision that Quixote interprets as combat.">>
<<ownChoice "form-insult" "Irony simply means that Quixote is stupid and Sancho is always right.">></div></section></div>

:: Consequence5
<div class="novel"><aside class="scene-side"><<ownStage 4>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><h1>The world answers in wood</h1><div class="story-beats"><<ownConsequence 4>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision6">><</button>></div></section></div>

:: Decision6
<div class="novel"><aside class="scene-side"><<ownStage 5>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>The explanation that survives everything</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>Quixote says the enchanter Friston has turned the giants into mills to rob him of glory. He refers to an earlier account of his vanished library. The narrator reports his explanation without confirming that a transformation happened.</p><p>Sancho’s mouth tightens. He has already identified windmills before the charge. The knight can make that inconvenient detail disappear by adding more magic, but I need to ask what could then count against the explanation.</p><p>Counterevidence is relevant evidence that challenges a claim. If every possible result becomes proof of the same claim, an explanation stops being open to correction. My journal will not write “false because I dislike it.” It asks for a reason.</p></div><div class="after-beats"><<ownSource "friston">><<ownChoice "counter-before" "Sancho identifies mills before the charge; a transformation after defeat does not account for that earlier observation.">>
<<ownChoice "counter-test" "The narrator supplies mills and mechanical causes, while the transformation lacks confirmation; I ask what evidence could challenge it.">>
<<ownChoice "counter-magic" "Because magic explains any outcome, the transformation must be true.">></div></section></div>

:: Consequence6
<div class="novel"><aside class="scene-side"><<ownStage 5>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><h1>The explanation that survives everything</h1><div class="story-beats"><<ownConsequence 5>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision7">><</button>></div></section></div>

:: Decision7
<div class="novel"><aside class="scene-side"><<ownStage 6>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>From a road to an argument</h1><p class="speaker">Sancho Panza</p><div class="story-beats"><p>Sancho helps Quixote remount. He does not withdraw his description of the mills. Being right has not made his companion unhurt, and assistance does not require him to adopt the giant story.</p><p>I think about a claim outside this journey: a rumor, a heroic narrative, an advertisement, or my own first interpretation of a text. When a result goes badly, it is tempting to protect the original story with an explanation that nothing could challenge.</p><p>A useful connection will transfer a method, not declare that modern people and a Spanish literary character are identical. What should I carry back from this disagreement?</p></div><div class="after-beats"><<ownMargin 6>><<ownChoice "transfer-test" "For another claim, separate observations from explanations and ask what would count against it; then check relevant evidence.">>
<<ownChoice "transfer-compare" "Compare this with a specific hero’s response to a setback: what evidence is available, and does the hero revise or protect the original belief?">>
<<ownChoice "transfer-everyone" "Anyone with a hopeful dream is just another Don Quixote, so dreams should be abandoned.">></div></section></div>

:: Consequence7
<div class="novel"><aside class="scene-side"><<ownStage 6>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><h1>From a road to an argument</h1><div class="story-beats"><<ownConsequence 6>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision8">><</button>></div></section></div>

:: Decision8
<div class="novel"><aside class="scene-side"><<ownStage 7>><<ownStats>><p class="charge">A commitment · no correctness points</p></aside><section class="dialogue"><div class="eyebrow">The Giants Have Sails</div><h1>What the witness leaves on the page</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>The road continues toward Puerto Lapice. Quixote still expects adventures. Sancho still has practical concerns. The sails turn behind us, grinding grain with no apparent interest in reputation.</p><p>I cannot claim that my argument changed the knight. I can decide how to record a conversation that failed. The account must make his hope intelligible without giving his explanation evidence it does not have.</p><p>My journal reopens to the question that brought me here. I may write what I discovered and what remains uncertain. I have witnessed a canonical event; I have also learned that a strong reason and a successful persuasion are different things.</p></div><div class="after-beats"><<ownPersonal "reflection">><<ownChoice "record-separate" "I record the mills and fall as events, and his enchantment story as a claim, adding why the earlier evidence challenges it.">>
<<ownChoice "record-voices" "I preserve both voices, then explain why the narrator’s details and Sancho’s mechanism support the mill account.">>
<<ownChoice "record-flatter" "I call the defeated giants a victory and omit the mill evidence.">></div></section></div>

