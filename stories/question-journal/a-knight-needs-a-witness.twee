:: StoryTitle
A Knight Needs a Witness

:: StoryData
{"ifid":"0359962D-4E51-45D6-9701-153CF70F9FF1","format":"SugarCube","format-version":"2.37.3","start":"Start"}

:: StoryScript [script]
// Published journal v1 rules. Scores depend only on explicit evidence checkpoints.
const notebookDomains=['Evidence','Interpretation','Language & Form','Connections'];
function journalContent(story){
 const assessYoung=(choices=[])=>{
  if(!Array.isArray(choices)||choices.length>story.scenes.length)throw new Error('Invalid journal route');
  const scores=[0,0,0,0];choices.forEach((id,i)=>{const c=story.scenes[i].choices.find(c=>c.id===id);if(!c)throw new Error('Invalid journal choice');c.points.forEach((p,j)=>scores[j]+=p);});
  const complete=choices.length===story.scenes.length;
  return {complete,scores,total:scores.reduce((a,b)=>a+b,0),indicators:scores,ending:complete?{title:'What I discovered; what I still wonder',paragraphs:[story.scenes.at(-1).choices.find(c=>c.id===choices.at(-1)).response,'My account can be accurate even when the knight disagrees. The journal keeps evidence, inference, and unanswered questions together.']}:null};
 };
 const assessDriver=(attempts=[])=>{
  if(!Array.isArray(attempts)||attempts.length>200)throw new Error('Invalid completion checks');
  let score=0,passed=false;for(const answers of attempts){if(passed)throw new Error('The return check is already complete');if(!Array.isArray(answers)||answers.length!==4||answers.some((a,i)=>!Number.isInteger(a)||a<0||a>=story.driverQuestions[i].options.length))throw new Error('Answer all four journal questions');score=answers.filter((a,i)=>a===story.driverQuestions[i].answer).length;passed=score>=3;}
  return {passed,score};
 };
 return {...story,scenes:story.scenes,sourceNotes:story.sources,assignmentPrompt:'Record what you discovered and what remains uncertain.',rubric:notebookDomains.map(n=>n+': 25 points from its explicit checkpoint; 25 supported reasoning, 5 unsupported overclaim, 0 not yet demonstrated.'),assessYoung,assessDriver};
}
function validateJournal(journal={},choices=[],sceneCount){
 if(!journal||typeof journal!=='object'||Array.isArray(journal)||Object.keys(journal).some(k=>!['question','reflection'].includes(k)))throw new Error('Invalid journal writing');
 for(const key of ['question','reflection'])if(journal[key]!==undefined&&(typeof journal[key]!=='string'||journal[key].length>1000))throw new Error('Keep each journal entry within 1000 characters');
 if(journal.question!==undefined&&!choices.length||journal.reflection!==undefined&&choices.length!==sceneCount)throw new Error('Journal entry outside its passage');
 return {...journal};
}
function journalProgress(a,sceneCount){
 const j=validateJournal(a.journal,a.choices,sceneCount);
 return [...a.choices.map((id,i)=>JSON.stringify({id,...(i===0?{question:j.question||''}:{}),...(i===sceneCount-1?{reflection:j.reflection||''}:{})})),...(a.driverAttempts||[]).map(v=>JSON.stringify(v))];
}

setup.story={"id":"a-knight-needs-a-witness","version":1,"title":"A Knight Needs a Witness","chapter":"I.1","boundary":"Part I, chapter 1: opening portrait, reading habits, armor and helmet, naming Rocinante and Don Quixote, ending with Dulcinea. No later plot revealed.","concepts":["characterization","diction","parody"],"sources":[{"id":"books","title":"A life rearranged by reading","quote":"he sold many an acre of tillageland to buy books of chivalry to read","note":"This is an action reported by the narrator, not a direct statement of the gentleman’s feelings. Books of chivalry are romances about knights and idealized adventures. The action supports an inference about his priorities; it does not establish that every reader behaves this way.","url":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch1"},{"id":"armor","title":"A test and its aftermath","quote":"not caring to try any more experiments with it, he passed it and adopted it as a helmet of the most perfect construction.","note":"After a sword test breaks his pasteboard repair, he rebuilds it with iron bars and chooses not to test again. “Most perfect” is the narrator’s report of the adopted assessment, in tension with the testing history. Pasteboard means layers of paper/cardboard; a morion is an open helmet. Preserve the distinction between observation and claimed perfection.","url":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch1"},{"id":"names","title":"A name that makes a claim","quote":"a distinguished and full-sounding one, befitting the new order and calling he was about to follow.","note":"He spends four days naming his horse Rocinante and then eight naming himself Don Quixote. The chosen words give an ordinary horse and gentleman a grand imagined identity. Diction is purposeful word choice. This English phrasing belongs to John Ormsby’s translation, not Cervantes’s original Spanish.","url":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch1"}],"scenes":[{"title":"The door on the cover","speaker":"journal","cast":[],"text":["Mr. Hepting sets an old journal on the desk. Its leather cover looks as if it has survived rain, travel, and a serious disagreement with a suitcase zipper.","‘I found this in an airport gift shop in Peru,’ he says. ‘Between the marmalade and the neck pillows. I asked it why boarding groups exist. I was gone three days.’ On the cover, someone has drawn a door. The little brass handle feels surprisingly real.","‘A new question on a new line,’ he says. ‘Then touch the door. It takes you somewhere you can investigate. Answers are your responsibility. So is coming back.’ I write a question. The page smells faintly of oranges. No classmates follow me: this small door is an invitation for one."],"choices":[{"id":"name","label":"How much can a name change a person?","response":"I write about names. The ink stretches into a narrow road. My own name stays on this side of the cover; the question goes ahead of me.","points":[0,0,0,0]},{"id":"hero","label":"What makes someone a hero before the first adventure?","response":"I write about heroes. The door grows tall enough for my shoulders. Somewhere beyond it, somebody is polishing something that squeaks.","points":[0,0,0,0]},{"id":"books","label":"Can a story change the way we see ordinary things?","response":"I write about stories. The little handle warms in my palm. The page turns itself, patiently waiting for me to stop staring and enter.","points":[0,0,0,0]}],"kind":"question","source":null,"margin":null},{"title":"An appointment with no salary","speaker":"quixote","cast":["quixote"],"text":["I step into a courtyard in La Mancha, a region of Spain. An older gentleman has placed a rusty helmet beside a pile of books. His horse watches the arrangement with the weary patience of an animal excluded from the planning committee.","‘At last,’ the gentleman says. ‘A chronicler.’ A chronicler records what happens. I explain that I have mostly recorded homework. ‘A promising apprenticeship,’ he says. ‘Will you witness my beginning? The world cannot remember a deed it never hears about.’","He calls himself Don Quixote. He is preparing to become a knight-errant: a wandering knight who seeks adventures and rights wrongs. His armor belonged to his great-grandfather. His confidence is considerably newer. I accept the appointment for this visit. My problem is already clear: can I tell the truth about him without making his hopes into a joke?"],"choices":[{"id":"ask-purpose","label":"I ask what he hopes a chronicler can preserve.","response":"‘That I tried,’ he says, then straightens. ‘And my considerable victories, when they become available.’ The second answer stands proudly beside the first. I suspect the first is carrying more weight.","points":[0,0,0,0]},{"id":"ask-household","label":"I ask who else should be heard.","response":"His niece appears at the doorway, carrying folded linen. ‘Someone who knows where the bread is kept,’ she says. Quixote introduces her with affection and immediately promises that glory will not interfere with lunch. She looks unconvinced.","points":[0,0,0,0]}],"kind":"question","source":null,"margin":{"text":"A quill appears at the bottom edge of my page. Cervantes peers over it, smiling. “You have met a man and an ambition. Do not confuse either with my narrator. What do you actually know so far?”","followups":[{"q":"Can I ask what you intended?","a":"“You can ask. But my presence in this margin is an invitation to investigate, not proof of a private intention. Let the words make trouble for your first answer.”"}]}},{"title":"What the books cost","speaker":"niece","cast":["niece"],"text":["His niece opens the book-room door. Volumes lean against one another like tired travelers. I imagine a shelf that keeps getting larger while the field outside gets smaller.","‘He reads late,’ she says. ‘And speaks as if a book were giving him instructions.’ Her concern tells me about her perspective. It is not enough, by itself, to prove everything she fears. The journal offers a labelled fragment of the actual opening chapter.","Characterization means how a text builds our understanding of a character through actions, speech, description, and relationships. I need to separate what the passage states from what I infer. My first notebook entry must show that separation."],"choices":[{"id":"cost-evidence","label":"The narrator says he sells farmland for books; I infer that reading has become a powerful priority.","response":"The journal underlines “sold” and circles “infer.” The action is evidence; the priority is a defensible interpretation. The niece nods at the detail, then asks whether a powerful priority is always a wise one.","points":[25,0,0,0]},{"id":"cost-tension","label":"Selling land for books suggests devotion and poor judgment; the action supports both, without settling his whole character.","response":"I keep admiration and concern on the same line. A concrete action can support more than one inference. The niece is glad I have not made her uncle only a label.","points":[25,0,0,0]},{"id":"cost-general","label":"The passage proves that reading fiction makes everyone foolish.","response":"The journal asks: “Everyone?” One character’s reported action does not establish a universal cause. I mark this as an overclaim and retain the source beside it for review.","points":[5,0,0,0]}],"kind":"checkpoint","source":"books","margin":null},{"title":"What kind of chronicler?","speaker":"quixote","cast":["quixote"],"text":["Quixote offers me a quill whose feather has survived rather better than its tip. ‘Will your account be grand?’ he asks. His niece stays by the door. Neither wants him to disappear, though they mean different things by disappearing.","I can emphasize his aspiration or the gap between aspiration and household life. Either approach can be honest if I use evidence. The commitment changes whom I speak with and the tone of my account; it earns no correctness points. Praise may keep him listening but hide a problem. Direct skepticism may protect accuracy but close a conversation."],"choices":[{"id":"chronicler-hope","label":"I promise to begin with his hope, then test the claims it creates.","response":"He smiles. ‘Hope first. Excellent.’ When I add “test,” his smile pauses. He invites me to look at the helmet anyway. My kindness has opened a door; it has not made him agree.","points":[0,0,0,0]},{"id":"chronicler-gap","label":"I promise to record the ordinary details beside the heroic claims.","response":"His niece brings the helmet closer. Quixote looks wounded. ‘Ordinary details are notoriously ordinary.’ I explain that they can reveal what a heroic claim asks us to believe. He lets me stay, though he now watches my quill.","points":[0,0,0,0]},{"id":"chronicler-praise","label":"I promise to write only the grand parts so he will like my account.","response":"He is delighted. The niece withdraws to her work. I have won his approval and made my job harder: an account that cannot mention inconvenient details cannot examine its own claims. I will still have chances to reason carefully.","points":[0,0,0,0]}],"kind":"commitment","source":null,"margin":null},{"title":"A helmet of the most perfect construction","speaker":"quixote","cast":["quixote"],"text":["He raises the repaired helmet. Its paper parts suggest an expensive hat having a difficult morning. ‘I improved it,’ he says. The source card tells a fuller story: his first sword test destroyed a week’s work; after rebuilding with iron bars, he chose not to run another experiment.","I do not repeat the sword test. My appointment is to witness, not to alter the chapter. Instead I set the evidence beside the description “most perfect construction.” Diction is word choice; parody imitates the language or conventions of a genre while exposing their oddities or limits.","Here the grand confidence of knightly preparation sits beside a homemade repair and an avoided test. The comic effect has a cost: he needs this fragile thing to be enough. I choose the sentence that best explains how language produces that effect."],"choices":[{"id":"helmet-parody","label":"“Most perfect” echoes heroic certainty, while the avoided retest makes that certainty comic and questionable.","response":"My quill joins a phrase to an action. The diction claims perfection; the testing history unsettles it. This is a specific explanation of parody, not simply a judgment that the man is silly.","points":[0,0,25,0]},{"id":"helmet-ache","label":"The grand phrase makes the repair comic; the refused retest also suggests how much he wants his new identity to hold together.","response":"I explain the contrast before offering the inference about desire. The ache is an interpretation supported by the action, not a fact the source explicitly announces.","points":[0,0,25,0]},{"id":"helmet-literal","label":"“Most perfect” proves that the narrator has certified the helmet safe.","response":"I have treated an adopted claim as a successful experiment. The journal points me back to the avoided test. To explain the language, I must notice the tension between these details.","points":[0,0,5,0]}],"kind":"checkpoint","source":"armor","margin":{"text":"Cervantes nudges a comma with his quill. “Paper can be funny. A person needing paper to become steel may be sad. Can your reading make room for both?”","followups":[{"q":"Does comedy mean we should despise him?","a":"“Laughter can expose a mistake without finishing our judgment of the person. Which detail invites laughter? Which makes that laughter uncomfortable? Try answering separately.”"},{"q":"Are all knightly stories being rejected?","a":"“A parody can imitate conventions and test them. This scene gives you a failed preparation and extravagant confidence. It does not settle every possible value of every romance.”"}]}},{"title":"Names fit for the road","speaker":"quixote","cast":["quixote"],"text":["He introduces Rocinante, the horse. Rocinante lowers his head toward a patch of grass. This is not the introduction Quixote had rehearsed.","The source describes the effort to find a distinguished, full-sounding name. Quixote gives himself a grand name too, drawing on the conventions of the knights he has read about. A name can announce an aspiration without proving that the aspiration has been fulfilled.","He looks from the horse to me. ‘When the right name is found, a beginning becomes possible.’ I can hear the hope in his voice. My inference must still account for the gap between his words and the ordinary things around him."],"choices":[{"id":"names-inference","label":"The names help him perform a desired identity; ordinary details make that performance both hopeful and doubtful.","response":"I write “desired,” not “achieved.” His naming actions support self-invention, and the contrast keeps my conclusion qualified. He enjoys the word “hopeful” and politely declines “doubtful.” Both remain in my notebook.","points":[0,25,0,0]},{"id":"names-caution","label":"His careful naming shows commitment, but it cannot establish his readiness to be a knight.","response":"The inference stays close to the naming effort and admits its limit. I do not deny the commitment; I distinguish commitment from competence. Rocinante continues his own investigation of grass.","points":[0,25,0,0]},{"id":"names-proof","label":"The new names mean he has already become an accomplished hero.","response":"A claim of identity is not evidence of an accomplishment. I cross out “already.” His effort matters, but the source has not yet shown the heroic deeds this sentence assumes.","points":[0,5,0,0]}],"kind":"checkpoint","source":"names","margin":null},{"title":"A hero beside another hero","speaker":"niece","cast":["niece"],"text":["The niece walks with me to the gate. ‘If he wants to help people,’ she says, ‘must he first become a character from a book?’ She does not ask me to forbid his dream. She asks what the dream prevents him from seeing.","My journal draws two empty boxes: “this passage” and “another model of heroism.” I can connect Quixote’s preparation to a hero from our epic readings, or keep the comparison at the level of genre. A connection needs a shared feature and a meaningful difference. It should not turn two cultures into one easy rule.","The gate creaks. Soon I must finish the first page. Which connection can I defend with the evidence available?"],"choices":[{"id":"connect-genre","label":"Both epic heroes and Quixote may seek renown; this opening tests heroic preparation through domestic detail and parody.","response":"The connection names a shared aspiration and a difference in treatment. I would need a particular epic passage for a fuller comparison. I leave space for one rather than inventing a quotation.","points":[0,0,0,25]},{"id":"connect-role","label":"A hero’s reputation depends partly on a story being told; here the gap between naming and doing asks the chronicler to examine that reputation.","response":"I connect storytelling and heroism through the naming evidence. This is a question to take back to a specific epic, not a claim that every hero or culture values reputation in the same way.","points":[0,0,0,25]},{"id":"connect-culture","label":"This proves Spanish people mock heroes while ancient cultures admire all heroes.","response":"Two sweeping claims outrun the scene. A single text and a genre contrast cannot establish what entire cultures believe. I revise toward a named passage, a shared feature, and a limited difference.","points":[0,0,0,5]}],"kind":"checkpoint","source":null,"margin":{"text":"Cervantes holds the page open, but leaves the road untouched. “Your earlier heroes need not fit in my pocket. Bring a passage when you compare. What changes when a familiar heroic pose is tried in an ordinary courtyard?”","followups":[{"q":"Are author and narrator the same voice?","a":"“The historical author wrote the novel; a narrator tells it; Quixote speaks and acts within it. My margin visits here are another invented voice. Distinguish whose words you are using before claiming authority.”"}]}},{"title":"The introduction I can sign","speaker":"quixote","cast":["quixote"],"text":["Quixote stands by the gate, expecting a sentence large enough to march under. I am holding the small beginning I can actually justify. My first question is not completely answered. A name can help someone begin; it cannot do all the work of becoming.","I choose how to introduce him honestly—or how to handle the temptation to flatter him. My evidence and interpretation checkpoints have already earned their credit. His reaction will not change those points. The journal waits for an account I am willing to carry back.","Before I turn the page, I may add a private reflection: what did I discover, and what remains uncertain? The door on the cover is waiting. It requires understanding, not the knight’s approval."],"choices":[{"id":"intro-tender","label":"I introduce a man seeking heroic purpose, whose books and names outrun his tested equipment.","response":"He likes “purpose.” He objects to “outrun.” I read the helmet detail back to him, gently. He does not accept my wording, but he thanks me for staying long enough to find wording worth disputing. My account keeps hope and evidence together.","points":[0,0,0,0]},{"id":"intro-critical","label":"I introduce a would-be knight whose self-invention is exposed by ordinary details, while acknowledging the longing behind it.","response":"He folds his hands. ‘Would-be is a thin suit of armor.’ I cannot make the phrase painless. His niece asks me to leave “longing” in. I do. Honesty has cost me easy approval, and allowed a fuller portrait.","points":[0,0,0,0]},{"id":"intro-flatter","label":"I introduce an already perfect knight, omitting the evidence that contradicts the claim.","response":"He beams, then asks what I thought of the helmet. My sentence has made that question awkward. The journal records my chosen introduction beside my actual evidence: the difference is now visible to me. I can name what needs revision even after failing to say it aloud.","points":[0,0,0,0]}],"kind":"commitment","source":null,"margin":null}],"driverQuestions":[{"prompt":"Which entry separates evidence from inference?","options":["He sells land for books; this suggests that reading has become a priority.","He is heroic because he gives himself a heroic name.","Everyone who reads fiction loses judgment."],"answer":0,"note":"The reported sale is evidence. The priority is an inference supported by that action."},{"prompt":"Why is “most perfect construction” comic in the helmet passage?","options":["It is a technical safety certificate.","Grand confidence contrasts with a repair he chooses not to retest.","All old armor is worthless."],"answer":1,"note":"The grand description and the avoided experiment pull in different directions; connect wording with action."},{"prompt":"Which reading of the new names is most defensible?","options":["Names guarantee successful deeds.","The horse shares the knight’s beliefs.","Names perform an aspiration without proving it achieved."],"answer":2,"note":"Diction can announce identity. It cannot establish competence or accomplishments that have not been shown."},{"prompt":"Which comparison should I carry into class?","options":["All cultures have the same definition of a hero.","Compare one heroic aspiration across specific passages, and explain a difference in treatment.","A parody cannot contain admiration."],"answer":1,"note":"A useful comparison preserves specific evidence and differences. Parody can coexist with sympathy."}],"sourceUrl":"https://www.gutenberg.org/files/996/996-h/996-h.htm#ch1","edition":"Miguel de Cervantes, Don Quixote, translated by John Ormsby (1885), Project Gutenberg eBook 996, public domain.","checked":"2026-10-10","notes":"Original dialogue, student appointment, journal magic, and Cervantes margin visits are authored fiction. Labelled source cards alone contain authentic excerpts. Author, narrator, and character voices are distinct. These are episode concepts; a current assigned weekly vocabulary list and class translation were not verified. Read the assigned class text as well. No live AI responses."};const content=journalContent(setup.story);setup.scenes=content.scenes;setup.assess=content.assessYoung;setup.assessDriver=content.assessDriver;setup.driverQuestions=content.driverQuestions;setup.sources=content.sourceNotes;setup.characters={quixote:"Don Quixote",sancho:"Sancho Panza",niece:"Quixote’s niece",journal:"My journal"};
Config.history.maxStates=1;Config.history.controls=false;Config.saves.isAllowed=()=>false;Config.ui.stowBarInitially=true;Config.passages.nobr=true;
setup.attemptId=parent===window?crypto.randomUUID():'standalone';setup.choices=[];setup.driverAttempts=[];setup.journal={};setup.drafts={};setup.channel=null;setup.ready=false;setup.booted=false;setup.accepted=false;
Config.navigation.override=destination=>setup.ready?destination:'Start';
setup.send=(type,extra={})=>{if(parent!==window&&setup.channel)parent.postMessage({protocol:'episode-v1',episode:setup.story.id,version:setup.story.version,channel:setup.channel,type,choices:setup.choices.slice(),driverAttempts:setup.driverAttempts.map(v=>v.slice()),journal:{...setup.journal},...extra},location.origin);};
setup.refresh=()=>Engine.play(!setup.accepted?'Start':setup.choices.length===setup.scenes.length?(setup.assessDriver(setup.driverAttempts).passed?'Assessment':'Driver'):setup.choices.length?'Consequence'+setup.choices.length:'Decision1');
window.addEventListener('message',event=>{const m=event.data;if(event.origin!==location.origin||event.source!==parent||m?.protocol!=='episode-v1'||m.type!=='init'||m.episode!==setup.story.id||m.version!==setup.story.version||typeof m.channel!=='string')return;if(setup.ready){if(setup.booted){if(State.passage==='Start')setup.refresh();setup.send('started');}return;}try{setup.assess(m.choices);setup.assessDriver(m.driverAttempts||[]);validateJournal(m.journal,m.choices,setup.scenes.length);}catch{return;}setup.attemptId=typeof m.attemptId==='string'?m.attemptId:'standalone';setup.channel=m.channel;setup.choices=m.choices.slice();setup.journal={...m.journal};setup.drafts={...m.journalDraft};setup.accepted=setup.choices.length>0;setup.driverAttempts=(m.driverAttempts||[]).map(v=>v.slice());setup.ready=true;if(setup.booted){setup.refresh();setup.send('started');}});
const paragraph=(target,text)=>{const p=document.createElement('p');p.textContent=text;target.append(p);return p;};
const asset=n=>'../../question-journal/v1/'+n;
Macro.add('ownChoice',{handler(){const [id,label]=this.args,step=setup.choices.length,b=document.createElement('button');b.className='stone-choice';b.textContent=label;b.onclick=()=>{if(b.disabled||setup.choices.length!==step)return;b.disabled=true;const input=document.getElementById('journal-entry');if(input){if(step===0)setup.journal.question=input.value;else if(step===setup.scenes.length-1)setup.journal.reflection=input.value;}setup.choices.push(id);setup.send('save');Engine.play('Consequence'+(step+1));};this.output.append(b);}});
Macro.add('ownPersonal',{handler(){const key=this.args[0],label=document.createElement('label'),input=document.createElement('textarea');input.id='journal-entry';input.rows=3;input.maxLength=1000;label.htmlFor=input.id;label.textContent=key==='question'?'My own question (optional)':'What I discovered; what remains uncertain (optional)';input.value=setup.drafts[key]||setup.journal[key]||'';input.oninput=()=>{setup.drafts[key]=input.value;setup.send('draft',{field:key,text:input.value});};this.output.append(label,input);paragraph(this.output,'This private line is saved when I choose below. It earns no correctness points and does not generate a bespoke answer.');}});
Macro.add('ownConsequence',{handler(){const i=Number(this.args[0]),c=setup.scenes[i].choices.find(c=>c.id===setup.choices[i]);paragraph(this.output,c.response);if(i===0&&setup.journal.question)paragraph(this.output,'My personal question: '+setup.journal.question);}});
Macro.add('ownSource',{handler(){const ids=this.args.length?this.args:setup.sources.map(s=>s.id);for(const id of ids){const s=setup.sources.find(s=>s.id===id);if(!s)continue;const d=document.createElement('details');d.open=true;const title=document.createElement('summary');title.textContent='Source card · '+s.title;d.append(title);const q=document.createElement('blockquote');q.textContent=s.quote;d.append(q);paragraph(d,'Exact excerpt · Don Quixote '+setup.story.chapter+' · John Ormsby translation (1885)');paragraph(d,s.note);const a=document.createElement('a');a.href=s.url;a.target='_blank';a.rel='noopener';a.textContent='Read the full source chapter';d.append(a);this.output.append(d);}}});
Macro.add('ownStats',{handler(){const s=setup.assess(setup.choices),box=document.createElement('div');box.className='stone-stats';notebookDomains.forEach((name,i)=>{const cell=document.createElement('div'),label=document.createElement('span'),n=document.createElement('strong');label.textContent=name;n.textContent=s.scores[i]+'/25';cell.append(label,n);box.append(cell);});this.output.append(box);const d=document.createElement('details');d.innerHTML='<summary>My notebook rubric</summary><p>Four explicit checkpoints, each worth 25. Supported observation and reasoning earn 25; an unsupported overclaim earns 5; not yet demonstrated earns 0. Two distinct supported answers are available at every checkpoint. Question selection, character approval, and persuasion earn no correctness points. This private episode score is not a posted course grade.</p>';this.output.append(d);}});
Macro.add('ownStage',{handler(){const i=Number(this.args[0]),s=setup.scenes[i],stage=document.createElement('div');stage.className='stage';stage.style.backgroundImage='url("'+asset('landscape.webp')+'")';stage.setAttribute('role','group');stage.setAttribute('aria-label','La Mancha: courtyard, road, and distant windmills');if(s.speaker==='journal'){const door=document.createElement('div');door.className='journal-door';door.textContent='The Question Journal';const mark=document.createElement('span');mark.textContent='♧';door.append(mark);stage.append(door);}else{const figure=document.createElement('figure'),sprite=document.createElement('div'),caption=document.createElement('figcaption');figure.className='character speaking';sprite.className='sprite';sprite.style.backgroundImage='url("'+asset(s.speaker+'.webp')+'")';const mood=setup.story.id==='the-giants-have-sails'&&i>=4?'troubled':'neutral';sprite.style.backgroundPosition=mood==='troubled'?'100% 0':'0% 0';sprite.setAttribute('role','img');sprite.setAttribute('aria-label',setup.characters[s.speaker]+' · '+mood);caption.textContent=setup.characters[s.speaker]+' · '+mood;figure.append(sprite,caption);stage.append(figure);}this.output.append(stage);}});
Macro.add('ownMargin',{handler(){const margin=setup.scenes[Number(this.args[0])].margin;if(!margin)return;const inset=document.createElement('aside');inset.className='cervantes-margin';inset.setAttribute('aria-label','Cervantes at the edge of the page');const img=document.createElement('div');img.className='margin-portrait';img.style.backgroundImage='url("'+asset('cervantes.webp')+'")';img.setAttribute('role','img');img.setAttribute('aria-label','Cervantes peeking into the margin');inset.append(img);paragraph(inset,margin.text);margin.followups.forEach(f=>{const d=document.createElement('details'),sum=document.createElement('summary');sum.textContent=f.q;d.append(sum);paragraph(d,f.a);inset.append(d);});this.output.append(inset);}});
Macro.add('ownExplore',{handler(){const scene=setup.scenes[Number(this.args[0])];if(scene.kind!=='question')return;const heading=document.createElement('h2');heading.textContent='Keep asking, or continue';this.output.append(heading);scene.choices.filter(c=>c.id!==setup.choices[Number(this.args[0])]).forEach(c=>{const d=document.createElement('details'),summary=document.createElement('summary');summary.textContent=c.label;d.append(summary);paragraph(d,c.response);this.output.append(d);});}});
Macro.add('ownDriver',{handler(){const root=this.output,heading=document.createElement('h1');heading.textContent='The journal’s return page';root.append(heading);paragraph(root,'The door appears again on the cover. The journal asks four questions. Three correct open it. If I miss the threshold, I review and try again; my choices and personal writing remain safe.');const previous=setup.assessDriver(setup.driverAttempts);if(setup.driverAttempts.length){paragraph(root,'Last check: '+previous.score+'/4. My notebook and route are preserved.');const answers=setup.driverAttempts.at(-1);setup.driverQuestions.forEach((q,i)=>{if(answers[i]!==q.answer)paragraph(root,'Review '+(i+1)+': '+q.note);});}const form=document.createElement('form');root.append(form);setup.driverQuestions.forEach((q,i)=>{const group=document.createElement('fieldset'),legend=document.createElement('legend');legend.textContent=(i+1)+'. '+q.prompt;group.append(legend);q.options.forEach((text,n)=>{const label=document.createElement('label'),input=document.createElement('input');input.type='radio';input.name='fare-'+i;input.value=n;input.required=true;label.append(input,document.createTextNode(' '+text));group.append(label);});form.append(group);});const button=document.createElement('button');button.type='submit';button.textContent='Open the return door';form.append(button);form.onsubmit=event=>{event.preventDefault();if(!form.reportValidity())return;button.disabled=true;setup.driverAttempts.push(setup.driverQuestions.map((_,i)=>Number(new FormData(form).get('fare-'+i))));setup.send('save');setup.refresh();};const review=document.createElement('details'),summary=document.createElement('summary');summary.textContent='Review the source cards';review.append(summary);new Wikifier(review,'<<ownSource>>');root.append(review);}});
Macro.add('ownAssessment',{handler(){const a=setup.assess(setup.choices);paragraph(this.output,'The journal records what I discovered and leaves a space for what remains uncertain. The return door opens. I step through alone, back into the classroom. Mr. Hepting looks up. “Find anything?” I have more than an answer now: I have a better question.');a.ending.paragraphs.forEach(p=>paragraph(this.output,p));paragraph(this.output,'My first commitment: '+setup.scenes[3].choices.find(c=>c.id===setup.choices[3]).label);paragraph(this.output,'My opening question: '+setup.scenes[0].choices.find(c=>c.id===setup.choices[0]).label);if(setup.journal.question)paragraph(this.output,'My personal question: '+setup.journal.question);if(setup.journal.reflection)paragraph(this.output,'My reflection: '+setup.journal.reflection);paragraph(this.output,a.total+'/100 · Notebook learning');notebookDomains.forEach((n,i)=>paragraph(this.output,n+': '+a.scores[i]+'/25'));const d=document.createElement('details'),sum=document.createElement('summary');sum.textContent='See the evidence behind my score';d.append(sum);setup.choices.forEach((id,i)=>{const scene=setup.scenes[i],c=scene.choices.find(c=>c.id===id);if(scene.kind!=='checkpoint')return;paragraph(d,scene.title+' — '+c.label);paragraph(d,c.response+' Points: '+c.points.join(' / '));});this.output.append(d);paragraph(this.output,'Carry into class: choose one specific detail, explain what it supports, then name something it does not establish. My next encounter starts fresh, regardless of this score or the knight’s approval.');setup.send('complete');}});
// Passage-local pacing never changes the immutable choice history or score.
setup.cancelReveal=()=>{};
$(document).on(':passageinit',()=>setup.cancelReveal());
$(document).on(':passagedisplay',function(){
 const passage=document.querySelector('.passage'),beats=passage.querySelector('.story-beats'),after=passage.querySelector('.after-beats');
 if(beats&&after){
  const paragraphs=Array.from(beats.children);const full=document.createElement('div');full.className='sr-only';full.innerHTML=beats.innerHTML;beats.before(full);beats.setAttribute('aria-hidden','true');let index=0,timer=null,finish=()=>{};
  const controls=document.createElement('div');controls.className='beat-controls';
  const next=document.createElement('button'),all=document.createElement('button'),counter=document.createElement('span');
  next.textContent='Next ▸';all.textContent='Show all';all.className='quiet';counter.className='beat-count';
  controls.append(counter,next,all);beats.after(controls);after.hidden=true;
  const stop=()=>{if(timer)clearInterval(timer);timer=null;};setup.cancelReveal=stop;
  const show=()=>{
   stop();paragraphs.forEach((p,i)=>p.hidden=i!==index);const p=paragraphs[index];
   counter.textContent=(index+1)+' / '+paragraphs.length;next.textContent=index===paragraphs.length-1?'Continue ▸':'Next ▸';
   // Keep full accessible text; the optional visual reveal never delays screen readers.
   const original=p.innerHTML;finish=()=>{stop();p.innerHTML=original;};
   if(!matchMedia('(prefers-reduced-motion: reduce)').matches){
    const accessible=document.createElement('span');accessible.className='sr-only';accessible.innerHTML=original;
    const visual=document.createElement('span');visual.setAttribute('aria-hidden','true');visual.innerHTML=original;
    p.replaceChildren(accessible,visual);const walker=document.createTreeWalker(visual,NodeFilter.SHOW_TEXT),nodes=[];let node;
    while((node=walker.nextNode()))nodes.push({node,text:node.textContent});nodes.forEach(n=>n.node.textContent='');
    let n=0,c=0;timer=setInterval(()=>{for(let j=0;j<3&&n<nodes.length;j++){const entry=nodes[n];entry.node.textContent=entry.text.slice(0,++c);if(c>=entry.text.length){n++;c=0;}}if(n===nodes.length)finish();},16);
   }
  };
  const unlock=(showAll=false)=>{finish();if(showAll)paragraphs.forEach(p=>p.hidden=false);else{const recall=document.createElement('details');recall.innerHTML='<summary>Recall the conversation</summary>'+paragraphs.map(p=>'<p>'+p.innerHTML+'</p>').join('');after.prepend(recall);}controls.remove();after.hidden=false;const target=after.querySelector('summary,button');target?.focus({preventScroll:true});};
  next.addEventListener('click',()=>{if(timer){finish();return;}if(index<paragraphs.length-1){index++;show();}else unlock();});
  all.addEventListener('click',()=>unlock(true));show();
 }
 const h=passage.querySelector('h1');if(h){h.setAttribute('tabindex','-1');h.focus({preventScroll:true});}window.scrollTo(0,0);
});

$(document).one(':storyready',()=>{setup.booted=true;if(setup.channel){setup.refresh();setup.send('started');}if(parent===window){setup.ready=true;setup.refresh();return;}parent.postMessage({protocol:'episode-v1',episode:setup.story.id,version:setup.story.version,type:'ready'},location.origin);});


:: StoryStylesheet [stylesheet]
:root{color-scheme:dark}*{box-sizing:border-box}body{margin:0;background:#172c2c;color:#f7edd8;font:18px/1.65 Georgia,serif}#ui-bar{display:none}#story,#ui-bar.stowed~#story{margin:0!important}#passages{max-width:1200px;margin:auto;padding:0}.passage{padding:24px;min-height:95vh}.novel{display:grid;grid-template-columns:minmax(260px,.95fr) minmax(300px,1.05fr);gap:26px}.scene-side{position:sticky;top:18px;align-self:start}.stage{height:300px;display:flex;align-items:end;justify-content:center;background:#967c4c url('village-pixel.webp') center/cover;border:3px solid #b3975f;box-shadow:0 8px 0 #0f2024;image-rendering:pixelated;overflow:hidden}.character{width:min(50%,210px);margin:0;position:relative;filter:brightness(.9)}.character.speaking{filter:none}.sprite{width:100%;aspect-ratio:4/5;background-size:300% 100%;background-repeat:no-repeat;image-rendering:pixelated}figcaption{background:#102725e8;color:#f9e8bc;font:12px/1.5 system-ui,sans-serif;text-align:center;padding:5px 2px}.dialogue{background:#fcf3df;color:#30291f;border:3px solid #b3975f;padding:24px;box-shadow:0 8px 0 #0f2024;min-height:480px}h1,h2{line-height:1.18;letter-spacing:-.02em}h1{font-size:1.9rem;margin:12px 0}h2{font-size:1.5rem}h1:focus{outline:none}p{margin:0 0 1em}.eyebrow,.speaker,.stone-stats,button,summary,.charge,.beat-count,.choice-heading{font-family:system-ui,sans-serif}.eyebrow{font-size:.65rem;text-transform:uppercase;letter-spacing:.17em;color:#776042}.speaker{font-size:.8rem;color:#725728;font-weight:650;border-bottom:1px solid #cbb990;padding-bottom:10px}.story-beats{min-height:190px}.story-beats strong{color:#1f665c}.stone-choice,button{display:block;width:100%;margin:10px 0;padding:12px 14px;text-align:left;border:2px solid #9c8559;border-radius:3px;background:#eee2c6;color:#243f37;font-size:.94rem;line-height:1.5;cursor:pointer;min-height:48px}.stone-choice:hover,button:hover{background:#dfebcf;border-color:#577a6d}button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid #2391aa;outline-offset:3px}button:disabled{color:#746f62;background:#eeeae2;cursor:not-allowed;opacity:.75}.stone-stats{display:grid;gap:3px;margin:18px 0 8px}.stone-stats>div{display:flex;justify-content:space-between;gap:10px;padding:7px 12px;background:#213b39;border-left:3px solid #b3975f}.stone-stats span{font-size:.75rem;color:#cfccb7}.stone-stats strong{font-size:.8rem;font-weight:600}details{font-size:.88rem;border-bottom:1px solid #b3975f66;padding:12px 0;margin-bottom:12px}summary{cursor:pointer;color:inherit;font-weight:600}details p{margin:12px 0 0}.charge{font-size:.7rem;color:#dfc782;letter-spacing:.1em}.score{padding:16px;background:#315849;color:#fff3c7;font-size:1.3rem;border-radius:3px}a{color:#82cfc0}.dialogue a{color:#22645b}.passage li{margin:8px 0}.stone-note{padding:12px 16px;border-left:3px solid #bcb08d;background:#29423c}.beat-controls{display:flex;align-items:center;gap:8px}.beat-controls button{width:auto}.beat-controls .quiet{margin-left:auto;background:transparent;border-color:transparent;font-size:.75rem}.beat-count{font-size:.7rem;white-space:nowrap}.choice-heading{font-size:.7rem;text-transform:uppercase;letter-spacing:.12em;margin-top:20px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}[hidden]{display:none!important}@media(max-width:680px){body{font-size:17px}.passage{padding:10px}.novel{display:block}.scene-side{position:static}.stage{height:190px}.character{width:128px}.sprite{height:160px;aspect-ratio:auto}.stone-stats{grid-template-columns:1fr 1fr;margin:12px 0 6px;gap:4px}.stone-stats>div{display:block;padding:5px 8px}.stone-stats span,.stone-stats strong{display:block;font-size:.68rem}.scene-side details{padding:5px 0;font-size:.75rem;margin-bottom:4px}.charge{margin:6px 0 12px}.dialogue{padding:18px;min-height:350px}h1{font-size:1.5rem}.story-beats{min-height:150px}.stone-choice{font-size:.9rem}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}

#passage-assessment,#passage-nextlife,#passage-start{max-width:800px;margin:auto}#passage-assessment .eyebrow,#passage-nextlife .eyebrow,#passage-start .eyebrow{color:#dfc782}

blockquote{border-left:4px solid #b3975f;padding:8px 14px;margin:12px 0}#passage-assessment a{color:#bcefe1}.stage{background-color:#26453f}.sprite{background-size:300% 100%}

/* Cervantes occupies page space, never floats over controls. */
.cervantes-margin{margin:24px 0 18px auto;max-width:400px;border:2px dashed #9c8559;background:#eadfc7;padding:16px;color:#40342a;font-size:.88rem;min-height:130px}.margin-portrait{float:right;width:72px;height:90px;background-size:300% 100%;background-position:0 0;image-rendering:pixelated;margin:0 0 8px 12px}.cervantes-margin:after{content:"";display:block;clear:both}.cervantes-margin details{clear:both}.journal-door{border:3px solid #533a23;border-radius:10px 10px 0 0;background:#a58a59;color:#241e13;text-align:center;font-size:20px;padding:20px;width:160px;height:205px;box-shadow:inset 0 0 0 6px #715536}.journal-door span{display:block;font-size:40px;line-height:1.6}textarea{display:block;background:#fff8e7;border:2px solid #9c8559;color:#30291f;width:100%;font:16px/1.5 system-ui;padding:12px;margin:8px 0}fieldset{margin:18px 0;padding:14px;border:1px solid #9c8559}fieldset label{display:block;padding:10px 0;min-height:48px;cursor:pointer}fieldset input{margin-right:8px}#passage-driver{max-width:800px;margin:auto}#passage-driver a{color:#bcefe1}@media(max-width:680px){.cervantes-margin{max-width:none;width:100%;margin:16px 0}.journal-door{height:170px;width:135px;font-size:16px;padding:12px}.character{width:128px}.stage{height:190px}}


:: Start
<div class="eyebrow">World Literature · The Question Journal</div><h1>A Knight Needs a Witness</h1><p>12–15 minutes with optional conversations · Two consequential commitments · No timer · Independent replays</p><p>All characters are imaginative recreations of real or fictional people and may not represent their actual views or ideas. Only labelled source excerpts are authentic quotations.</p><<if setup.ready>><<button "Accept">><<run setup.accepted=true;setup.refresh()>><</button>><<else>><p>Connecting to my class…</p><</if>>

:: Decision1
<div class="novel"><aside class="scene-side"><<ownStage 0>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><div class="eyebrow">A Knight Needs a Witness</div><h1>The door on the cover</h1><p class="speaker">My journal</p><div class="story-beats"><p>Mr. Hepting sets an old journal on the desk. Its leather cover looks as if it has survived rain, travel, and a serious disagreement with a suitcase zipper.</p><p>‘I found this in an airport gift shop in Peru,’ he says. ‘Between the marmalade and the neck pillows. I asked it why boarding groups exist. I was gone three days.’ On the cover, someone has drawn a door. The little brass handle feels surprisingly real.</p><p>‘A new question on a new line,’ he says. ‘Then touch the door. It takes you somewhere you can investigate. Answers are your responsibility. So is coming back.’ I write a question. The page smells faintly of oranges. No classmates follow me: this small door is an invitation for one.</p></div><div class="after-beats"><<ownPersonal "question">><<ownChoice "name" "How much can a name change a person?">>
<<ownChoice "hero" "What makes someone a hero before the first adventure?">>
<<ownChoice "books" "Can a story change the way we see ordinary things?">></div></section></div>

:: Consequence1
<div class="novel"><aside class="scene-side"><<ownStage 0>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><h1>The door on the cover</h1><div class="story-beats"><<ownConsequence 0>></div><div class="after-beats"><<ownExplore 0>><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision2">><</button>></div></section></div>

:: Decision2
<div class="novel"><aside class="scene-side"><<ownStage 1>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><div class="eyebrow">A Knight Needs a Witness</div><h1>An appointment with no salary</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>I step into a courtyard in La Mancha, a region of Spain. An older gentleman has placed a rusty helmet beside a pile of books. His horse watches the arrangement with the weary patience of an animal excluded from the planning committee.</p><p>‘At last,’ the gentleman says. ‘A chronicler.’ A chronicler records what happens. I explain that I have mostly recorded homework. ‘A promising apprenticeship,’ he says. ‘Will you witness my beginning? The world cannot remember a deed it never hears about.’</p><p>He calls himself Don Quixote. He is preparing to become a knight-errant: a wandering knight who seeks adventures and rights wrongs. His armor belonged to his great-grandfather. His confidence is considerably newer. I accept the appointment for this visit. My problem is already clear: can I tell the truth about him without making his hopes into a joke?</p></div><div class="after-beats"><<ownMargin 1>><<ownChoice "ask-purpose" "I ask what he hopes a chronicler can preserve.">>
<<ownChoice "ask-household" "I ask who else should be heard.">></div></section></div>

:: Consequence2
<div class="novel"><aside class="scene-side"><<ownStage 1>><<ownStats>><p class="charge">Follow my curiosity</p></aside><section class="dialogue"><h1>An appointment with no salary</h1><div class="story-beats"><<ownConsequence 1>></div><div class="after-beats"><<ownExplore 1>><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision3">><</button>></div></section></div>

:: Decision3
<div class="novel"><aside class="scene-side"><<ownStage 2>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">A Knight Needs a Witness</div><h1>What the books cost</h1><p class="speaker">Quixote’s niece</p><div class="story-beats"><p>His niece opens the book-room door. Volumes lean against one another like tired travelers. I imagine a shelf that keeps getting larger while the field outside gets smaller.</p><p>‘He reads late,’ she says. ‘And speaks as if a book were giving him instructions.’ Her concern tells me about her perspective. It is not enough, by itself, to prove everything she fears. The journal offers a labelled fragment of the actual opening chapter.</p><p>Characterization means how a text builds our understanding of a character through actions, speech, description, and relationships. I need to separate what the passage states from what I infer. My first notebook entry must show that separation.</p></div><div class="after-beats"><<ownSource "books">><<ownChoice "cost-evidence" "The narrator says he sells farmland for books; I infer that reading has become a powerful priority.">>
<<ownChoice "cost-tension" "Selling land for books suggests devotion and poor judgment; the action supports both, without settling his whole character.">>
<<ownChoice "cost-general" "The passage proves that reading fiction makes everyone foolish.">></div></section></div>

:: Consequence3
<div class="novel"><aside class="scene-side"><<ownStage 2>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><h1>What the books cost</h1><div class="story-beats"><<ownConsequence 2>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision4">><</button>></div></section></div>

:: Decision4
<div class="novel"><aside class="scene-side"><<ownStage 3>><<ownStats>><p class="charge">A commitment · no correctness points</p></aside><section class="dialogue"><div class="eyebrow">A Knight Needs a Witness</div><h1>What kind of chronicler?</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>Quixote offers me a quill whose feather has survived rather better than its tip. ‘Will your account be grand?’ he asks. His niece stays by the door. Neither wants him to disappear, though they mean different things by disappearing.</p><p>I can emphasize his aspiration or the gap between aspiration and household life. Either approach can be honest if I use evidence. The commitment changes whom I speak with and the tone of my account; it earns no correctness points. Praise may keep him listening but hide a problem. Direct skepticism may protect accuracy but close a conversation.</p></div><div class="after-beats"><<ownChoice "chronicler-hope" "I promise to begin with his hope, then test the claims it creates.">>
<<ownChoice "chronicler-gap" "I promise to record the ordinary details beside the heroic claims.">>
<<ownChoice "chronicler-praise" "I promise to write only the grand parts so he will like my account.">></div></section></div>

:: Consequence4
<div class="novel"><aside class="scene-side"><<ownStage 3>><<ownStats>><p class="charge">A commitment · no correctness points</p></aside><section class="dialogue"><h1>What kind of chronicler?</h1><div class="story-beats"><<ownConsequence 3>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision5">><</button>></div></section></div>

:: Decision5
<div class="novel"><aside class="scene-side"><<ownStage 4>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">A Knight Needs a Witness</div><h1>A helmet of the most perfect construction</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>He raises the repaired helmet. Its paper parts suggest an expensive hat having a difficult morning. ‘I improved it,’ he says. The source card tells a fuller story: his first sword test destroyed a week’s work; after rebuilding with iron bars, he chose not to run another experiment.</p><p>I do not repeat the sword test. My appointment is to witness, not to alter the chapter. Instead I set the evidence beside the description “most perfect construction.” Diction is word choice; parody imitates the language or conventions of a genre while exposing their oddities or limits.</p><p>Here the grand confidence of knightly preparation sits beside a homemade repair and an avoided test. The comic effect has a cost: he needs this fragile thing to be enough. I choose the sentence that best explains how language produces that effect.</p></div><div class="after-beats"><<ownSource "armor">><<ownMargin 4>><<ownChoice "helmet-parody" "“Most perfect” echoes heroic certainty, while the avoided retest makes that certainty comic and questionable.">>
<<ownChoice "helmet-ache" "The grand phrase makes the repair comic; the refused retest also suggests how much he wants his new identity to hold together.">>
<<ownChoice "helmet-literal" "“Most perfect” proves that the narrator has certified the helmet safe.">></div></section></div>

:: Consequence5
<div class="novel"><aside class="scene-side"><<ownStage 4>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><h1>A helmet of the most perfect construction</h1><div class="story-beats"><<ownConsequence 4>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision6">><</button>></div></section></div>

:: Decision6
<div class="novel"><aside class="scene-side"><<ownStage 5>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">A Knight Needs a Witness</div><h1>Names fit for the road</h1><p class="speaker">Don Quixote</p><div class="story-beats"><p>He introduces Rocinante, the horse. Rocinante lowers his head toward a patch of grass. This is not the introduction Quixote had rehearsed.</p><p>The source describes the effort to find a distinguished, full-sounding name. Quixote gives himself a grand name too, drawing on the conventions of the knights he has read about. A name can announce an aspiration without proving that the aspiration has been fulfilled.</p><p>He looks from the horse to me. ‘When the right name is found, a beginning becomes possible.’ I can hear the hope in his voice. My inference must still account for the gap between his words and the ordinary things around him.</p></div><div class="after-beats"><<ownSource "names">><<ownChoice "names-inference" "The names help him perform a desired identity; ordinary details make that performance both hopeful and doubtful.">>
<<ownChoice "names-caution" "His careful naming shows commitment, but it cannot establish his readiness to be a knight.">>
<<ownChoice "names-proof" "The new names mean he has already become an accomplished hero.">></div></section></div>

:: Consequence6
<div class="novel"><aside class="scene-side"><<ownStage 5>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><h1>Names fit for the road</h1><div class="story-beats"><<ownConsequence 5>></div><div class="after-beats"><details><summary>Consult the source excerpts</summary><<ownSource>></details><<button "Continue">><<goto "Decision7">><</button>></div></section></div>

:: Decision7
<div class="novel"><aside class="scene-side"><<ownStage 6>><<ownStats>><p class="charge">Evidence checkpoint</p></aside><section class="dialogue"><div class="eyebrow">A Knight Needs a Witness</div><h1>A hero beside another hero</h1><p class="speaker">Quixote’s niece</p><div class="story-beats"><p>The niece walks with me to the gate. ‘If he wants to help people,’ she says, ‘must he first become a character from a book?’ She does not ask me to forbid his dream. She asks what the dream prevents him from seeing.</p><p>My journal draws two empty boxes: “this passage” and “another model of heroism.” I can connect Quixote’s preparation to a hero from our epic readings, or keep the comparison at the level of genre. A connection needs a shared feature and a meaningful difference. It should not turn two cultures into one easy rule.</p><p>The gate creaks. Soon I must finish the first page. Which connection can I defend with the evidence available?</p></div><div class="after-beats"><<ownMargin 6>><<ownChoice "connect-genre" "Both epic heroes and Quixote may seek renown; this opening tests heroic preparation through domestic detail and parody.">>
<<ownChoice "connect-role" "A hero’s reputation depends partly on a story being told; here the gap between naming and doing asks the chronicler to examine that reputation.">>
<<ownChoice "connect-culture" "This proves Spanish people mock heroes while ancient cultures admire all heroes.">></div></section></div>

:: Consequence7
