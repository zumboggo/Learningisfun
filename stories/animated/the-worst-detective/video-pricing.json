                          "x-order": 8,
                          "nullable": true,
                          "description": "Random seed for reproducible generation."
                        },
                        "image": {
                          "type": "string",
                          "title": "Image",
                          "format": "uri",
                          "x-order": 3,
                          "nullable": true,
                          "description": "First-frame reference image."
                        },
                        "prompt": {
                          "type": "string",
                          "title": "Prompt",
                          "x-order": 0,
                          "description": "Text prompt for video generation."
                        },
                        "duration": {
                          "type": "integer",
                          "title": "Duration",
                          "default": 5,
                          "maximum": 15,
                          "minimum": 5,
                          "x-order": 5,
                          "description": "Video duration in seconds."
                        },
                        "resolution": {
                          "enum": [
                            "480p",
                            "768p",
                            "1080p",
