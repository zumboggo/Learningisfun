            "required": [
              "prompt"
            ],
            "properties": {
              "mode": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/mode"
                  }
                ],
                "default": "speed",
                "x-order": 1,
                "description": "Generation mode: quality, speed, or cost."
              },
              "seed": {
                "type": "integer",
                "title": "Seed",
                "x-order": 8,
                "nullable": true,
                "description": "Random seed for reproducible generation."
              },
              "image": {
                "type": "string",
                "title": "Image",
                "format": "uri",
                "x-order": 3,
                "nullable": true,
                "description": "First-frame reference image."
              },
              "prompt": {
                "type": "string",
                "title": "Prompt",
                "x-order": 0,
                "description": "Text prompt for video generation."
              },
              "duration": {
                "type": "integer",
                "title": "Duration",
                "default": 5,
                "maximum": 15,
                "minimum": 5,
                "x-order": 5,
                "description": "Video duration in seconds."
              },
              "resolution": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/resolution"
                  }
                ],
                "default": "768p",
                "x-order": 6,
                "description": "Video resolution. 1080p, 2k and 4k generate at 768p and upscale it (24 fps kept)."
              },
              "aspect_ratio": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/aspect_ratio"
                  }
                ],
                "default": "16:9",
                "x-order": 7,
                "description": "Aspect ratio; reference images determine the canvas when provided."
              },
              "last_frame_image": {
                "type": "string",
                "title": "Last Frame Image",
                "format": "uri",
                "x-order": 4,
                "nullable": true,
                "description": "Last-frame reference image."
              },
              "prompt_upsampler": {
                "allOf": [
                  {
                    "$ref": "#/components/schemas/prompt_upsampler"
                  }
                ],
                "default": "turbo",
                "x-order": 2,
                "description": "Expand your prompt before video generation."
              },
              "enable_safety_filter": {
                "type": "boolean",
                "title": "Enable Safety Filter",
                "default": false,
                "x-order": 9,
                "description": "Check the inputs against the content policy. When off, only the always-on categories (sexual content involving minors, self-harm intent or instructions) are still blocked."
              }
            }
          },
