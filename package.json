{
  "name": "learning-is-fun",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run story:check && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "canvas:push": "node --env-file=.env.canvas.local scripts/push-to-canvas.mjs",
    "test": "vitest run && npm run test:stone && npm run test:episodes",
    "test:watch": "vitest",
    "story:build": "node scripts/build-stone.mjs && node scripts/build-young.mjs",
    "story:check": "node scripts/build-stone.mjs --check && node scripts/build-young.mjs --check",
    "test:stone": "node --test functions/learning-content/src/stone-checks.mjs",
    "test:episodes": "node --test functions/learning-content/src/episodes-checks.mjs"
  },
  "dependencies": {
    "appwrite": "^26.0.0",
    "dexie": "^4.4.3",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^12.43.0",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.17.0",
    "ts-fsrs": "^5.4.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "6.2.4",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "node-appwrite": "^27.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "word-extractor": "^1.0.4",
    "workbox-window": "^7.4.1"
  }
}
