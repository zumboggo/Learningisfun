# Canvas push configuration — copy to .env.canvas.local and fill in.
# .env.canvas.local is gitignored and is read ONLY by scripts/push-to-canvas.mjs,
# which runs on your machine. These values are never bundled into the web app.

# Your Canvas host, no trailing slash.
CANVAS_BASE_URL=https://yourschool.instructure.com

# Canvas > Account > Settings > Approved Integrations > + New Access Token.
# This token acts as you on every course you teach — treat it like a password.
CANVAS_API_TOKEN=

# The number in your course URL: /courses/12345
CANVAS_COURSE_ID=
